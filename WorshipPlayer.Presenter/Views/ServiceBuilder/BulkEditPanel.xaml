<UserControl x:Class="WorshipPlayer.Presenter.Views.ServiceBuilder.BulkEditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="12">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top" x:Name="HeaderText"
                       Text="Bulk Edit (0 items selected)"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <!-- Bottom buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="DeleteSelectedButton" Content="Delete Selected"
                        Style="{StaticResource OwcButtonBase}"
                        Foreground="{StaticResource OwcLiveBrush}"
                        Click="DeleteSelected_Click" Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton" Content="Apply to 0 items"
                        Style="{StaticResource OwcAccentButton}"
                        Click="Apply_Click"/>
            </StackPanel>

            <!-- Batch Properties -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="Select multiple items in the service list to batch-edit their properties."
                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Margin="0,8" Visibility="Visible"/>

                    <!-- Batch options panel -->
                    <StackPanel x:Name="BatchOptionsPanel" Visibility="Collapsed">
                        <!-- Background -->
                        <CheckBox x:Name="ApplyBackgroundCheck" Margin="0,4"
                                  Foreground="{StaticResource OwcTextPrimaryBrush}" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Set Background: " VerticalAlignment="Center"/>
                                <ComboBox x:Name="BackgroundComboBox" Width="150"
                                          Background="{StaticResource OwcSurfaceBrush}"
                                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                                          FontSize="12" Padding="6,4">
                                    <ComboBoxItem Content="None" IsSelected="True"/>
                                    <ComboBoxItem Content="Solid Color"/>
                                    <ComboBoxItem Content="Image"/>
                                    <ComboBoxItem Content="Video"/>
                                </ComboBox>
                            </StackPanel>
                        </CheckBox>

                        <!-- Transition Time -->
                        <CheckBox x:Name="ApplyTransitionCheck" Margin="0,8"
                                  Foreground="{StaticResource OwcTextPrimaryBrush}" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Set Transition: " VerticalAlignment="Center"/>
                                <Slider x:Name="BatchTransitionSlider" Width="120"
                                        Style="{StaticResource OwcSlider}"
                                        Minimum="0" Maximum="3000" Value="500"
                                        VerticalAlignment="Center"/>
                                <TextBlock x:Name="BatchTransitionValue" Text="500 ms"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                           FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Auto-Advance -->
                        <CheckBox x:Name="ApplyAutoAdvanceCheck" Margin="0,8"
                                  Foreground="{StaticResource OwcTextPrimaryBrush}" FontSize="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Set Auto-Advance: " VerticalAlignment="Center"/>
                                <ComboBox x:Name="AutoAdvanceComboBox" Width="130"
                                          Background="{StaticResource OwcSurfaceBrush}"
                                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                                          FontSize="12" Padding="6,4">
                                    <ComboBoxItem Content="Manual" IsSelected="True"/>
                                    <ComboBoxItem Content="Time Delay"/>
                                    <ComboBoxItem Content="End of Media"/>
                                </ComboBox>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
