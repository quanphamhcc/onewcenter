<Window x:Class="WorshipPlayer.Presenter.Views.ServiceBuilder.ServiceInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Service Info"
        SizeToContent="Height"
        MinWidth="420" Width="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource OwcButtonBase}"
                    Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80"/>
            <Button x:Name="SaveButton" Content="Create" Style="{StaticResource OwcAccentButton}"
                    Click="Save_Click" MinWidth="100"/>
        </StackPanel>

        <StackPanel>
            <!-- Service name -->
            <TextBlock Text="Service name" Foreground="{StaticResource OwcTextSecondaryBrush}"
                       FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="NameTextBox" Style="{StaticResource OwcTextBox}"
                     Margin="0,0,0,16"/>

            <!-- Service date (US format MM/DD/YYYY hh:mm AM/PM) -->
            <TextBlock Text="Service date" Foreground="{StaticResource OwcTextSecondaryBrush}"
                       FontSize="11" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <DatePicker x:Name="DatePickerControl" Grid.Column="0"
                            Background="{StaticResource OwcSurfaceBrush}"
                            Foreground="#0F1117"
                            BorderBrush="{StaticResource OwcBorderBrush}"
                            FontSize="13"/>

                <TextBox x:Name="TimeTextBox" Grid.Column="2"
                         Style="{StaticResource OwcTextBox}"
                         ToolTip="Time in US format, e.g. 08:00 AM (optional)"/>
            </Grid>
            <TextBlock Text="MM/DD/YYYY and time like 08:00 AM (time optional)"
                       Foreground="{StaticResource OwcTextMutedBrush}"
                       FontSize="10" Margin="0,4,0,0"/>

            <TextBlock x:Name="ValidationText" Text=""
                       Foreground="{StaticResource OwcWarningBrush}"
                       FontSize="11" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
