<UserControl x:Class="WorshipPlayer.Presenter.Views.ServiceBuilder.ServicesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="#0F1117">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: Filters + Search (left), + New Service (right) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <ComboBox x:Name="FiltersComboBox" Style="{StaticResource OwcDarkComboBox}"
                          Width="120" Height="32" VerticalAlignment="Center" Margin="0,0,8,0"
                          SelectedIndex="0">
                    <ComboBoxItem Style="{StaticResource OwcDarkComboBoxItem}" Content="All" />
                </ComboBox>
                <TextBox x:Name="SearchTextBox" Style="{StaticResource OwcTextBox}"
                         Width="260" Height="32" VerticalAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged" />
            </StackPanel>

            <Button Content="+ New Service" Style="{StaticResource OwcAccentButton}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="130"
                    Click="NewService_Click" />
        </Grid>

        <!-- Services table -->
        <ListView x:Name="ServicesList" Grid.Row="1" Style="{StaticResource OwcDarkListView}"
                  SelectionChanged="ServicesList_SelectionChanged">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{StaticResource OwcDarkGridViewColumnHeader}">
                    <GridViewColumn Header="Date" Width="160">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DateDisplay}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource OwcTextPrimaryBrush}" Padding="8,8" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Type" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Type}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}" Padding="8,8" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Title" Width="240">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource OwcTextPrimaryBrush}" Padding="8,8" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Last modified" Width="140">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastModifiedDisplay}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}" Padding="8,8" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Last modified by" Width="130">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastModifiedBy}" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}" Padding="8,8" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="" Width="44">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="&#x22EE;" Style="{StaticResource OwcButtonBase}"
                                        Background="Transparent" Padding="6,2" FontSize="16"
                                        Click="Overflow_Click" Tag="{Binding FilePath}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open" Click="Open_Click" Tag="{Binding FilePath}" />
                                            <MenuItem Header="Rename" Click="Rename_Click" Tag="{Binding FilePath}" />
                                            <MenuItem Header="Delete" Click="Delete_Click" Tag="{Binding FilePath}" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
