<UserControl x:Class="WorshipPlayer.Presenter.Views.ServiceBuilder.ItemSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="14">
        <DockPanel>
            <!-- Header -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Item Settings" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource OwcTextPrimaryBrush}"/>
                <TextBlock x:Name="ItemTitleText" Text=""
                           FontSize="12"
                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Save button at bottom -->
            <Button DockPanel.Dock="Bottom" Content="Save Settings"
                    Style="{StaticResource OwcAccentButton}"
                    HorizontalAlignment="Right" Margin="0,12,0,0"
                    Click="Save_Click"/>

            <!-- Settings -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="Select an item to view and edit its settings."
                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8"
                               Visibility="Visible"/>

                    <!-- Settings panel -->
                    <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                        <!-- Auto-Advance Go To -->
                        <TextBlock Text="Go To" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="GoToComboBox" Margin="0,0,0,12"
                                  Background="{StaticResource OwcSurfaceBrush}"
                                  Foreground="{StaticResource OwcTextPrimaryBrush}"
                                  FontSize="12" Padding="8,6">
                            <ComboBoxItem Content="Next Item" IsSelected="True"/>
                            <ComboBoxItem Content="Specific Item"/>
                            <ComboBoxItem Content="Loop"/>
                        </ComboBox>

                        <!-- After Condition -->
                        <TextBlock Text="After Condition" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AfterConditionComboBox" Margin="0,0,0,12"
                                  Background="{StaticResource OwcSurfaceBrush}"
                                  Foreground="{StaticResource OwcTextPrimaryBrush}"
                                  FontSize="12" Padding="8,6">
                            <ComboBoxItem Content="Manual" IsSelected="True"/>
                            <ComboBoxItem Content="Time Delay"/>
                            <ComboBoxItem Content="End of Media"/>
                        </ComboBox>

                        <!-- Transition Fade Time -->
                        <TextBlock Text="Transition Fade Time"
                                   Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FadeTimeSlider" Style="{StaticResource OwcSlider}"
                                    Minimum="0" Maximum="3000" Value="500"
                                    TickFrequency="100" IsSnapToTickEnabled="True"
                                    ValueChanged="FadeTimeSlider_ValueChanged"/>
                            <TextBlock x:Name="FadeTimeText" Grid.Column="1"
                                       Text="500 ms"
                                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
