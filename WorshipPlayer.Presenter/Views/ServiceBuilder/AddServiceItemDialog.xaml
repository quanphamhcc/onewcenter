<Window x:Class="WorshipPlayer.Presenter.Views.ServiceBuilder.AddServiceItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Service Item"
        SizeToContent="Height"
        MinWidth="500" Width="520"
        MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource OwcButtonBase}"
                    Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80"/>
            <Button x:Name="AddItemButton" Content="Add Item" Style="{StaticResource OwcAccentButton}"
                    Click="AddItem_Click" MinWidth="100"/>
        </StackPanel>

        <!-- Main content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- New-service fields: only shown when creating a brand-new service
                     order (no current service loaded and not editing an item). -->
                <StackPanel x:Name="NewServicePanel" Visibility="Collapsed">
                    <TextBlock Text="Service name" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="ServiceNameTextBox" Style="{StaticResource OwcTextBox}"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Service date" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="ServiceDateTextBox" Style="{StaticResource OwcTextBox}"
                             ToolTip="MM/DD/YYYY with optional time, e.g. 10/18/2026 08:00 AM"/>
                    <TextBlock Text="MM/DD/YYYY and time like 08:00 AM (time optional)"
                               Foreground="{StaticResource OwcTextMutedBrush}"
                               FontSize="10" Margin="0,4,0,12"/>

                    <Border Height="1" Background="{StaticResource OwcBorderBrush}"
                            Margin="0,0,0,12"/>
                </StackPanel>

                <!-- Item Type -->
                <TextBlock Text="Item Type" Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,4"/>
                <ComboBox x:Name="ItemTypeComboBox" Margin="0,0,0,12"
                          Style="{StaticResource OwcDarkComboBox}"
                          FontSize="13" Padding="8,6"
                          SelectionChanged="ItemTypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Song" IsSelected="True"/>
                    <ComboBoxItem Content="Scripture"/>
                    <ComboBoxItem Content="Announcement"/>
                    <ComboBoxItem Content="Sermon"/>
                    <ComboBoxItem Content="Video"/>
                    <ComboBoxItem Content="Blank"/>
                    <ComboBoxItem Content="Custom"/>
                </ComboBox>

                <!-- Song picker: shown only for Item Type = Song. Pick a real library
                     song (Title — Artist); selecting one auto-fills Item name and links
                     the item via SongFolder. -->
                <StackPanel x:Name="SongPickerPanel">
                    <TextBlock Text="Song" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SongPickerComboBox" Margin="0,0,0,12"
                              Style="{StaticResource OwcDarkComboBox}"
                              FontSize="13" Padding="8,6"
                              IsEditable="True" IsTextSearchEnabled="True" IsReadOnly="False"
                              DisplayMemberPath="Display"
                              ToolTip="Search and pick a song from the library"
                              SelectionChanged="SongPickerComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- Scripture reference: shown only for Item Type = Scripture. -->
                <StackPanel x:Name="ScripturePanel" Visibility="Collapsed">
                    <TextBlock Text="Scripture reference" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="ScriptureReferenceTextBox" Style="{StaticResource OwcTextBox}"
                             Margin="0,0,0,12"
                             ToolTip="e.g. John 3:16"/>
                </StackPanel>

                <!-- Item name / title (shown in the service order list) -->
                <TextBlock Text="Item name" Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="ItemTitleTextBox" Style="{StaticResource OwcTextBox}"
                         Margin="0,0,0,12"
                         ToolTip="Name shown in the service order (e.g. the song or item title)"/>

                <!-- Background Type -->
                <TextBlock Text="Background Type" Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,4"/>
                <ComboBox x:Name="BackgroundTypeComboBox" Margin="0,0,0,12"
                          Style="{StaticResource OwcDarkComboBox}"
                          FontSize="13" Padding="8,6">
                    <ComboBoxItem Content="None" IsSelected="True"/>
                    <ComboBoxItem Content="Solid Color"/>
                    <ComboBoxItem Content="Image"/>
                    <ComboBoxItem Content="Video"/>
                    <ComboBoxItem Content="Gradient"/>
                </ComboBox>

                <!-- Foreground Type -->
                <TextBlock Text="Foreground Type" Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,4"/>
                <ComboBox x:Name="ForegroundTypeComboBox" Margin="0,0,0,12"
                          Style="{StaticResource OwcDarkComboBox}"
                          FontSize="13" Padding="8,6">
                    <ComboBoxItem Content="Text" IsSelected="True"/>
                    <ComboBoxItem Content="Image"/>
                    <ComboBoxItem Content="None"/>
                </ComboBox>

                <!-- Auto-Advance Settings -->
                <TextBlock Text="Auto-Advance" Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,8,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Go To:" Foreground="{StaticResource OwcTextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="GoToComboBox" Grid.Column="1"
                              Style="{StaticResource OwcDarkComboBox}"
                              FontSize="13" Padding="8,6">
                        <ComboBoxItem Content="Next Item" IsSelected="True"/>
                        <ComboBoxItem Content="Specific Item"/>
                        <ComboBoxItem Content="Loop"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="After:" Foreground="{StaticResource OwcTextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="AfterConditionComboBox" Grid.Column="1"
                              Style="{StaticResource OwcDarkComboBox}"
                              FontSize="13" Padding="8,6">
                        <ComboBoxItem Content="Manual" IsSelected="True"/>
                        <ComboBoxItem Content="Time Delay"/>
                        <ComboBoxItem Content="End of Media"/>
                    </ComboBox>
                </Grid>

                <!-- Transition Time -->
                <TextBlock Text="Transition Time (ms)" Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="TransitionSlider" Style="{StaticResource OwcSlider}"
                            Minimum="0" Maximum="3000" Value="500"
                            TickFrequency="100" IsSnapToTickEnabled="True"
                            ValueChanged="TransitionSlider_ValueChanged"/>
                    <TextBlock x:Name="TransitionValueText" Grid.Column="1"
                               Text="500" Foreground="{StaticResource OwcTextPrimaryBrush}"
                               FontSize="12" VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- Audio Attachment -->
                <TextBlock Text="Audio Attachment (optional)" Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AudioPathTextBox" IsReadOnly="True"
                             Background="{StaticResource OwcSurfaceBrush}"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             BorderBrush="{StaticResource OwcBorderBrush}"
                             Padding="8,6" FontSize="12"/>
                    <Button Content="Browse..." Grid.Column="1"
                            Style="{StaticResource OwcButtonBase}"
                            Click="BrowseAudio_Click" Margin="8,0,0,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
