<UserControl x:Class="WorshipPlayer.Presenter.Views.Scripture.ScriptureBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="12">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top" Text="Scripture"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <!-- Reference input -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ReferenceTextBox"
                         Style="{StaticResource OwcTextBox}"
                         KeyDown="ReferenceTextBox_KeyDown"/>
                <ComboBox x:Name="TranslationComboBox" Grid.Column="2"
                          Style="{StaticResource OwcDarkComboBox}"
                          FontSize="12" Padding="6,4" MinWidth="70">
                    <ComboBoxItem Content="KJV" IsSelected="True"/>
                    <ComboBoxItem Content="WEB"/>
                </ComboBox>
                <Button Content="Look Up" Grid.Column="4"
                        Style="{StaticResource OwcAccentButton}"
                        Click="LookUp_Click" MinWidth="80"/>
            </Grid>

            <!-- Hint text -->
            <TextBlock DockPanel.Dock="Top"
                       Text="Type a reference like John 3:16 or Romans 8:28-30"
                       Foreground="{StaticResource OwcTextMutedBrush}"
                       FontSize="11" Margin="0,0,0,8"/>

            <!-- E5: display-option toggles (bound to the slide generator's options) -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="ShowReferenceCheckBox"
                          Content="Show reference" IsChecked="True"
                          Foreground="{StaticResource OwcTextSecondaryBrush}"
                          FontSize="12" Margin="0,0,16,0"
                          Checked="Options_Changed" Unchecked="Options_Changed"/>
                <CheckBox x:Name="ShowTranslationCheckBox"
                          Content="Show translation" IsChecked="True"
                          Foreground="{StaticResource OwcTextSecondaryBrush}"
                          FontSize="12"
                          Checked="Options_Changed" Unchecked="Options_Changed"/>
            </StackPanel>

            <!-- Quick Scripture: present the current lookup on the live output
                 immediately (dot2-T13). Creates no service item. -->
            <Button x:Name="PresentButton" DockPanel.Dock="Bottom"
                    Content="Present Now" IsEnabled="False"
                    Style="{StaticResource OwcAccentButton}"
                    HorizontalAlignment="Right" Margin="0,12,0,0"
                    Click="Present_Click"/>

            <!-- Scripture to Slides (dot2-T14): save the current lookup into the
                 Slides library — as a new presentation or appended to an existing one. -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="Save to Slides library"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="PresentationNameTextBox"
                         Style="{StaticResource OwcTextBox}"
                         Margin="0,0,0,6"
                         ToolTip="Presentation name — defaults to the reference"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="TargetPresentationComboBox"
                              Style="{StaticResource OwcDarkComboBox}"
                              FontSize="12" Padding="6,4"/>
                    <Button x:Name="CreateSlidesButton" Grid.Column="2"
                            Content="Create Slides" IsEnabled="False"
                            Style="{StaticResource OwcAccentButton}"
                            MinWidth="100"
                            Click="CreateSlides_Click"/>
                </Grid>
                <TextBlock x:Name="SlidesStatusText"
                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Results area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="Enter a Bible reference above to look up scripture."
                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Margin="4,20" HorizontalAlignment="Center"
                               Visibility="Visible"/>

                    <!-- Results -->
                    <TextBlock x:Name="ResultsText"
                               Foreground="{StaticResource OwcTextPrimaryBrush}"
                               FontSize="13" TextWrapping="Wrap"
                               LineHeight="22"
                               Visibility="Collapsed"/>

                    <!-- Error message -->
                    <TextBlock x:Name="ErrorText"
                               Foreground="{StaticResource OwcLiveBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
