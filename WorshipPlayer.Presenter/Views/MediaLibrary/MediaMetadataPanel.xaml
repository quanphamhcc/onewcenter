<UserControl x:Class="WorshipPlayer.Presenter.Views.MediaLibrary.MediaMetadataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="14">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top" Text="Media Details"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,12"/>

            <!-- Save button at bottom -->
            <Button DockPanel.Dock="Bottom" Content="Save Tags"
                    Style="{StaticResource OwcAccentButton}"
                    HorizontalAlignment="Right" Margin="0,12,0,0"
                    Click="SaveTags_Click"/>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="Select a media item to view its details."
                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,8"
                               Visibility="Visible"/>

                    <!-- Details panel -->
                    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
                        <!-- Thumbnail preview -->
                        <Border Style="{StaticResource OwcSurfaceBorder}"
                                Width="180" Height="120" Margin="0,0,0,12"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="PreviewPlaceholder" Text="Preview"
                                       Foreground="{StaticResource OwcTextMutedBrush}"
                                       FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name -->
                        <TextBlock Text="Name" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock x:Name="NameText"
                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,10"/>

                        <!-- Type -->
                        <TextBlock Text="Type" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock x:Name="TypeText"
                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,10"/>

                        <!-- File Size -->
                        <TextBlock Text="File Size" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock x:Name="SizeText"
                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,10"/>

                        <!-- Date Added -->
                        <TextBlock Text="Date Added" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,2"/>
                        <TextBlock x:Name="DateText"
                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                   FontSize="13" Margin="0,0,0,10"/>

                        <!-- Tags -->
                        <TextBlock Text="Tags (comma-separated)" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="TagsTextBox"
                                 Background="{StaticResource OwcSurfaceBrush}"
                                 Foreground="{StaticResource OwcTextPrimaryBrush}"
                                 BorderBrush="{StaticResource OwcBorderBrush}"
                                 FontSize="12" Padding="8,6"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
