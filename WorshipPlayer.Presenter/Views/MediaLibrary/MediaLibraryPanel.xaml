<UserControl x:Class="WorshipPlayer.Presenter.Views.MediaLibrary.MediaLibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="12">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top" Text="Media Library"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <!-- Toolbar -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Import button -->
                <Button Content="Import" Style="{StaticResource OwcAccentButton}"
                        FontSize="11" Padding="10,5"
                        Click="Import_Click"/>

                <!-- Search -->
                <TextBox x:Name="SearchTextBox" Grid.Column="2"
                         Style="{StaticResource OwcTextBox}"
                         TextChanged="Search_TextChanged"/>

                <!-- View toggle -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button x:Name="GridViewButton" Content="Grid"
                            Style="{StaticResource OwcButtonBase}"
                            FontSize="10" Padding="8,4" Margin="0,0,4,0"
                            Click="GridView_Click"/>
                    <Button x:Name="ListViewButton" Content="List"
                            Style="{StaticResource OwcButtonBase}"
                            FontSize="10" Padding="8,4" Margin="0,0,4,0"
                            Click="ListView_Click"/>
                    <Button x:Name="CompactViewButton" Content="Compact"
                            Style="{StaticResource OwcButtonBase}"
                            FontSize="10" Padding="8,4"
                            Click="CompactView_Click"/>
                </StackPanel>
            </Grid>

            <!-- Type / Tag filters -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="TypeFilterComboBox" Grid.Column="0"
                          Style="{StaticResource OwcDarkComboBox}"
                          FontSize="11" Padding="6,4"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Types" IsSelected="True"/>
                    <ComboBoxItem Content="Image"/>
                    <ComboBoxItem Content="Video"/>
                    <ComboBoxItem Content="Audio"/>
                </ComboBox>

                <ComboBox x:Name="TagFilterComboBox" Grid.Column="2"
                          Style="{StaticResource OwcDarkComboBox}"
                          FontSize="11" Padding="6,4"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="All Tags" IsSelected="True"/>
                </ComboBox>

                <Button x:Name="ClearFiltersButton" Grid.Column="4" Content="Clear"
                        Style="{StaticResource OwcButtonBase}"
                        FontSize="10" Padding="8,4"
                        Click="ClearFilters_Click"/>
            </Grid>

            <!-- Content area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="No media files. Click Import to add images and videos."
                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Margin="4,20" HorizontalAlignment="Center"
                               Visibility="Visible"/>

                    <!-- Grid view (WrapPanel with thumbnails) -->
                    <WrapPanel x:Name="GridPanel" Visibility="Collapsed">
                        <!-- Dynamically populated with media thumbnails -->
                    </WrapPanel>

                    <!-- List view -->
                    <ListBox x:Name="ListPanel"
                             Style="{StaticResource OwcServiceListBox}"
                             Visibility="Collapsed"
                             SelectionChanged="MediaItem_Selected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Thumbnail placeholder -->
                                    <Border Background="{StaticResource OwcSurfaceBrush}"
                                            CornerRadius="4" Width="50" Height="35"/>
                                    <!-- Name -->
                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               Foreground="{StaticResource OwcTextPrimaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <!-- Type -->
                                    <TextBlock Grid.Column="3" Text="{Binding MediaType}"
                                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                                               FontSize="11" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
