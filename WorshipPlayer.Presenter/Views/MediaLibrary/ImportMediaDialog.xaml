<Window x:Class="WorshipPlayer.Presenter.Views.MediaLibrary.ImportMediaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Media"
        Width="500" Height="400"
        MinWidth="400" MinHeight="300"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Style="{StaticResource OwcButtonBase}"
                    Click="Close_Click" Margin="0,0,8,0" MinWidth="80"/>
            <Button x:Name="ImportButton" Content="Import Selected"
                    Style="{StaticResource OwcAccentButton}"
                    Click="ImportSelected_Click" MinWidth="120"
                    IsEnabled="False"/>
        </StackPanel>

        <!-- Header + Browse -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Import Media Files" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,10"/>
            <Button Content="Browse Files..." Style="{StaticResource OwcAccentButton}"
                    HorizontalAlignment="Left"
                    Click="BrowseFiles_Click"/>
        </StackPanel>

        <!-- Progress indicator -->
        <StackPanel DockPanel.Dock="Top" x:Name="ProgressPanel" Visibility="Collapsed"
                    Margin="0,0,0,8">
            <ProgressBar x:Name="ImportProgressBar" Height="6"
                         Background="{StaticResource OwcSurfaceBrush}"
                         Foreground="{StaticResource OwcAccentBrush}"
                         Margin="0,0,0,4"/>
            <TextBlock x:Name="ProgressText" Text="Importing..."
                       Foreground="{StaticResource OwcTextSecondaryBrush}"
                       FontSize="11"/>
        </StackPanel>

        <!-- File list -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
            <StackPanel>
                <!-- Empty state -->
                <TextBlock x:Name="EmptyStateText"
                           Text="Click 'Browse Files...' to select images and videos to import."
                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="4,20" HorizontalAlignment="Center"
                           Visibility="Visible"/>

                <!-- Files list -->
                <ListBox x:Name="FilesListBox"
                         Style="{StaticResource OwcServiceListBox}"
                         Visibility="Collapsed">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FileName}"
                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Status}"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
