<UserControl x:Class="WorshipPlayer.Presenter.Views.Templates.TemplateManagerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="12">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top" Text="Templates"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <!-- Toolbar -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="NewButton" Content="New"
                        Style="{StaticResource OwcAccentButton}"
                        FontSize="11" Padding="10,5" Margin="0,0,6,0"
                        Click="NewButton_Click"/>
                <Button x:Name="DuplicateButton" Content="Duplicate"
                        Style="{StaticResource OwcButtonBase}"
                        FontSize="11" Padding="10,5" Margin="0,0,6,0"
                        Click="DuplicateButton_Click"/>
                <Button x:Name="RenameButton" Content="Rename"
                        Style="{StaticResource OwcButtonBase}"
                        FontSize="11" Padding="10,5" Margin="0,0,6,0"
                        Click="RenameButton_Click"/>
                <Button x:Name="DeleteButton" Content="Delete"
                        Style="{StaticResource OwcButtonBase}"
                        FontSize="11" Padding="10,5"
                        Click="DeleteButton_Click"/>
            </StackPanel>

            <!-- Template List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="Create a template to customize your slide appearance."
                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Margin="4,20" HorizontalAlignment="Center"
                               Visibility="Collapsed"/>

                    <!-- Template list -->
                    <ListBox x:Name="TemplateListBox"
                             Style="{StaticResource OwcServiceListBox}"
                             SelectionChanged="TemplateList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Color swatch preview -->
                                        <Border Grid.Column="0" Width="24" Height="24"
                                                CornerRadius="4" Margin="0,0,10,0"
                                                Background="{Binding PreviewColor}"
                                                BorderBrush="{StaticResource OwcBorderBrush}"
                                                BorderThickness="1"/>

                                        <!-- Name -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Category}"
                                                       Foreground="{StaticResource OwcTextSecondaryBrush}"
                                                       FontSize="10"/>
                                        </StackPanel>

                                        <!-- Lock icon for built-ins -->
                                        <TextBlock Grid.Column="2" Text="&#x1F512;"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource OwcTextMutedBrush}"
                                                   Visibility="{Binding LockVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
