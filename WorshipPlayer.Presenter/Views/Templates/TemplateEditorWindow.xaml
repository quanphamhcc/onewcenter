<Window x:Class="WorshipPlayer.Presenter.Views.Templates.TemplateEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorshipPlayer.Presenter.Views.Templates"
        Title="Template Editor" Width="1000" Height="700"
        MinWidth="800" MinHeight="600"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource OwcPanelBrush}" Padding="16,10">
            <TextBlock x:Name="TitleText" Text="Edit Template - Default Centered"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"/>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Tab Settings -->
            <Border Grid.Column="0" Style="{StaticResource OwcPanelBorder}" Padding="12">
                <TabControl x:Name="SettingsTabs"
                            Background="Transparent"
                            BorderBrush="{StaticResource OwcBorderBrush}"
                            Foreground="{StaticResource OwcTextPrimaryBrush}">
                    <TabItem Header="Formatting">
                        <local:FormattingTab x:Name="FormattingTabControl" Margin="0,8,0,0"/>
                    </TabItem>
                    <TabItem Header="Advanced">
                        <local:AdvancedTab x:Name="AdvancedTabControl" Margin="0,8,0,0"/>
                    </TabItem>
                    <TabItem Header="Margins">
                        <local:MarginsTab x:Name="MarginsTabControl" Margin="0,8,0,0"/>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Right: Live Preview -->
            <Border Grid.Column="2" Style="{StaticResource OwcSurfaceBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Live Preview"
                               FontSize="11" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               Margin="12,8,12,4"/>

                    <Border Grid.Row="1" x:Name="PreviewBorder"
                            Background="#000000" Margin="8"
                            CornerRadius="4" ClipToBounds="True">
                        <Border x:Name="PreviewMarginBorder" Padding="40,40,40,40">
                            <TextBlock x:Name="PreviewText"
                                       Text="Amazing Grace how sweet the sound"
                                       FontSize="60" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Buttons -->
        <Border Grid.Row="2" Background="{StaticResource OwcPanelBrush}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource OwcButtonBase}"
                        Padding="16,8" Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Save Template"
                        Style="{StaticResource OwcAccentButton}"
                        Padding="16,8"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
