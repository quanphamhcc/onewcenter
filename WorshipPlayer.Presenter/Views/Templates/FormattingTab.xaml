<UserControl x:Class="WorshipPlayer.Presenter.Views.Templates.FormattingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Font Family -->
            <TextBlock Text="Font Family" FontSize="11" Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="FontFamilyComboBox"
                      Background="{StaticResource OwcSurfaceBrush}"
                      Foreground="{StaticResource OwcTextPrimaryBrush}"
                      FontSize="12" Padding="8,6" Margin="0,0,0,12"
                      SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="Segoe UI" IsSelected="True"/>
                <ComboBoxItem Content="Arial"/>
                <ComboBoxItem Content="Times New Roman"/>
                <ComboBoxItem Content="Georgia"/>
                <ComboBoxItem Content="Verdana"/>
                <ComboBoxItem Content="Calibri"/>
                <ComboBoxItem Content="Cambria"/>
                <ComboBoxItem Content="Tahoma"/>
                <ComboBoxItem Content="Impact"/>
                <ComboBoxItem Content="Consolas"/>
            </ComboBox>

            <!-- Font Size -->
            <TextBlock Text="Font Size" FontSize="11" Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="FontSizeSlider" Grid.Column="0"
                        Minimum="12" Maximum="120" Value="60"
                        Style="{StaticResource OwcSlider}"
                        ValueChanged="Slider_ValueChanged"/>
                <TextBlock Grid.Column="1" x:Name="FontSizeDisplay" Text="60"
                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                           FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Bold / Italic -->
            <TextBlock Text="Style" FontSize="11" Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <CheckBox x:Name="BoldToggle" Content="Bold"
                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                          FontSize="12" Margin="0,0,16,0" IsChecked="True"
                          Checked="Setting_Checked" Unchecked="Setting_Checked"/>
                <CheckBox x:Name="ItalicToggle" Content="Italic"
                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                          FontSize="12"
                          Checked="Setting_Checked" Unchecked="Setting_Checked"/>
            </StackPanel>

            <!-- Font Color -->
            <TextBlock Text="Font Color" FontSize="11" Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox x:Name="ColorHexTextBox" Text="#FFFFFF"
                         Background="{StaticResource OwcSurfaceBrush}"
                         Foreground="{StaticResource OwcTextPrimaryBrush}"
                         BorderBrush="{StaticResource OwcBorderBrush}"
                         FontSize="12" Padding="6,4" Width="90"
                         TextChanged="ColorHex_Changed"/>
                <Border x:Name="ColorSwatch" Width="28" Height="28"
                        Background="#FFFFFF" CornerRadius="4" Margin="8,0,0,0"
                        BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1"/>
            </StackPanel>

            <!-- Horizontal Alignment -->
            <TextBlock Text="Horizontal Alignment" FontSize="11" Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="HAlignLeft" Content="Left"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             FontSize="12" Margin="0,0,12,0"
                             Checked="Alignment_Changed"/>
                <RadioButton x:Name="HAlignCenter" Content="Center" IsChecked="True"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             FontSize="12" Margin="0,0,12,0"
                             Checked="Alignment_Changed"/>
                <RadioButton x:Name="HAlignRight" Content="Right"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             FontSize="12"
                             Checked="Alignment_Changed"/>
            </StackPanel>

            <!-- Vertical Alignment -->
            <TextBlock Text="Vertical Alignment" FontSize="11" Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="VAlignTop" Content="Top" GroupName="VAlign"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             FontSize="12" Margin="0,0,12,0"
                             Checked="Alignment_Changed"/>
                <RadioButton x:Name="VAlignCenter" Content="Center" GroupName="VAlign" IsChecked="True"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             FontSize="12" Margin="0,0,12,0"
                             Checked="Alignment_Changed"/>
                <RadioButton x:Name="VAlignBottom" Content="Bottom" GroupName="VAlign"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             FontSize="12"
                             Checked="Alignment_Changed"/>
            </StackPanel>

            <!-- Shadow -->
            <TextBlock Text="Effects" FontSize="11" Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <CheckBox x:Name="ShadowToggle" Content="Shadow"
                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                          FontSize="12" Margin="0,0,16,0" IsChecked="True"
                          Checked="Setting_Checked" Unchecked="Setting_Checked"/>
                <TextBox x:Name="ShadowColorTextBox" Text="#000000"
                         Background="{StaticResource OwcSurfaceBrush}"
                         Foreground="{StaticResource OwcTextPrimaryBrush}"
                         BorderBrush="{StaticResource OwcBorderBrush}"
                         FontSize="11" Padding="4,2" Width="70"
                         TextChanged="ColorHex_Changed"/>
            </StackPanel>

            <!-- Outline -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <CheckBox x:Name="OutlineToggle" Content="Outline"
                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                          FontSize="12" Margin="0,0,16,0"
                          Checked="Setting_Checked" Unchecked="Setting_Checked"/>
                <TextBox x:Name="OutlineColorTextBox" Text="#000000"
                         Background="{StaticResource OwcSurfaceBrush}"
                         Foreground="{StaticResource OwcTextPrimaryBrush}"
                         BorderBrush="{StaticResource OwcBorderBrush}"
                         FontSize="11" Padding="4,2" Width="70"
                         TextChanged="ColorHex_Changed"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
