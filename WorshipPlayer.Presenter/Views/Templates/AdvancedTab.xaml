<UserControl x:Class="WorshipPlayer.Presenter.Views.Templates.AdvancedTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Text Transform -->
            <TextBlock Text="Text Transform" FontSize="11"
                       Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <ComboBox x:Name="TextTransformComboBox"
                      Background="{StaticResource OwcSurfaceBrush}"
                      Foreground="{StaticResource OwcTextPrimaryBrush}"
                      FontSize="12" Padding="8,6" Margin="0,0,0,16"
                      SelectionChanged="Setting_Changed">
                <ComboBoxItem Content="None" IsSelected="True"/>
                <ComboBoxItem Content="Uppercase"/>
                <ComboBoxItem Content="Lowercase"/>
            </ComboBox>

            <!-- Letter Spacing -->
            <TextBlock Text="Letter Spacing" FontSize="11"
                       Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="LetterSpacingSlider" Grid.Column="0"
                        Minimum="0" Maximum="10" Value="0"
                        Style="{StaticResource OwcSlider}"
                        ValueChanged="LetterSpacing_ValueChanged"/>
                <TextBlock Grid.Column="1" x:Name="LetterSpacingDisplay" Text="0"
                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                           FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Line Height -->
            <TextBlock Text="Line Height" FontSize="11"
                       Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="LineHeightSlider" Grid.Column="0"
                        Minimum="1.0" Maximum="3.0" Value="1.3"
                        Style="{StaticResource OwcSlider}"
                        IsSnapToTickEnabled="True" TickFrequency="0.1"
                        ValueChanged="LineHeight_ValueChanged"/>
                <TextBlock Grid.Column="1" x:Name="LineHeightDisplay" Text="1.3"
                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                           FontSize="12" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Line Background -->
            <TextBlock Text="Line Background" FontSize="11"
                       Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="LineBackgroundToggle" Content="Enabled"
                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                          FontSize="12" Margin="0,0,16,0"
                          Checked="Setting_Checked" Unchecked="Setting_Checked"/>
                <TextBox x:Name="LineBackgroundColorTextBox" Text="#000000"
                         Background="{StaticResource OwcSurfaceBrush}"
                         Foreground="{StaticResource OwcTextPrimaryBrush}"
                         BorderBrush="{StaticResource OwcBorderBrush}"
                         FontSize="12" Padding="6,4" Width="90"
                         TextChanged="ColorHex_Changed"/>
                <Border x:Name="LineBackgroundSwatch" Width="28" Height="28"
                        Background="#000000" CornerRadius="4" Margin="8,0,0,0"
                        BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1"/>
            </StackPanel>

            <TextBlock Text="Line background adds a colored band behind each line of text, creating the 'Trendy Line' effect."
                       FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
