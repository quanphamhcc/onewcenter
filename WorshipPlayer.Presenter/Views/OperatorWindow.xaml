<Window x:Class="WorshipPlayer.Presenter.Views.OperatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OWC Presenter - Command Center"
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        ResizeMode="CanResize"
        Background="#0F1117"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <!-- NO resource dictionaries - all hardcoded to prevent template conflicts -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <!-- ROW 0: LIVE PREVIEW HERO BOXES -->
        <Grid Grid.Row="0" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Audience Preview -->
            <Border x:Name="AudiencePreviewBorder" Grid.Column="0"
                    Background="#1A1D27" CornerRadius="10"
                    BorderBrush="#2A2E3A" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonDown="AudiencePreview_Click">
                <Grid>
                    <TextBlock x:Name="CurrentSlidePreview" Text="(blank)"
                               FontSize="18" FontWeight="SemiBold" Foreground="#F0F2F5"
                               TextAlignment="Center" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="16" />
                    <TextBlock Text="AUDIENCE" FontSize="9" FontWeight="Bold"
                               Foreground="#8B92A5" HorizontalAlignment="Left"
                               VerticalAlignment="Top" Margin="10,6" />
                    <Border x:Name="LiveBadge" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Margin="10,6"
                            Background="#FF3366" CornerRadius="3"
                            Padding="6,2" Visibility="Collapsed">
                        <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>
            </Border>

            <!-- Stage Preview -->
            <Border Grid.Column="2" Background="#1A1D27" CornerRadius="10"
                    BorderBrush="#2A2E3A" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonDown="StagePreview_Click">
                <Grid>
                    <!-- STAGE preview: monospace chord-over-lyric layout (green chord row above white lyric row) -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                        <TextBlock x:Name="StagePreviewPlaceholder" Text="(standby)"
                                   FontSize="16" Foreground="#B0B4C0"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="StagePreviewSection" FontSize="12" FontWeight="Bold"
                                   Foreground="#7ED321" HorizontalAlignment="Center"
                                   Margin="0,0,0,6" Visibility="Collapsed" />
                        <ItemsControl x:Name="StagePreviewItems" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2,0,2">
                                        <TextBlock Text="{Binding ChordLine}"
                                                   FontFamily="Consolas, Courier New"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#7ED321" />
                                        <TextBlock Text="{Binding LyricLine}"
                                                   FontFamily="Consolas, Courier New"
                                                   FontSize="16" Foreground="White" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="STAGE" FontSize="9" FontWeight="Bold"
                               Foreground="#8B92A5" HorizontalAlignment="Left"
                               VerticalAlignment="Top" Margin="10,6" />
                    <StackPanel x:Name="StageConnectedIndicator" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,6">
                        <Ellipse x:Name="StageConnectedDot" Width="7" Height="7"
                                 Fill="#4A5068" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="StageConnectedText" Text="DISCONNECTED"
                                   FontSize="8" FontWeight="Bold" Foreground="#4A5068" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 1: HEADER BAR -->
        <Border Grid.Row="1" Background="#1A1D27" Padding="16,10"
                BorderBrush="#2A2E3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="OWC" FontSize="18" FontWeight="Bold"
                           Foreground="#00D4FF" VerticalAlignment="Center" />

                <Border Grid.Column="2" Background="#252A36" CornerRadius="6"
                        BorderBrush="#2A2E3A" BorderThickness="1"
                        VerticalAlignment="Center" Height="30" Padding="8,0">
                    <TextBlock Text="Search... (Ctrl+K)" FontSize="12"
                               Foreground="#4A5068" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Devices:" FontSize="11" Foreground="#8B92A5" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="ConnectedDevicesCount" Text="0" FontSize="11" FontWeight="Bold" Foreground="#00E676" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Ellipse x:Name="NdiStatusDot" Width="7" Height="7" Fill="#4A5068" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock x:Name="NdiStatusText" Text="NDI OFF" FontSize="11" Foreground="#8B92A5" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="NdiToggleButton" Content="OFF" FontSize="10" Padding="8,3"
                            Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                            Click="NdiToggle_Click" Cursor="Hand" />
                    <TextBlock x:Name="NdiToggleStatusText" Text="Inactive" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Theme:" FontSize="11" Foreground="#8B92A5" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="ThemeSelector" Width="120" Height="28" FontSize="11"
                              Background="#252A36" Foreground="#F0F2F5" BorderBrush="#2A2E3A" BorderThickness="1"
                              SelectionChanged="ThemeSelector_SelectionChanged" />
                </StackPanel>

                <CheckBox x:Name="ChordToggleCheckBox" Grid.Column="7" Content="Chords"
                          FontSize="11" Foreground="#F0F2F5" VerticalAlignment="Center" Margin="0,0,16,0"
                          Checked="ChordToggle_Changed" Unchecked="ChordToggle_Changed" />

                <Button Grid.Column="8" Content="&#x2699;" FontSize="16" Padding="6,2"
                        Background="Transparent" Foreground="#8B92A5" BorderBrush="Transparent" BorderThickness="0"
                        VerticalAlignment="Center" Click="DisplaySettings_Click" Cursor="Hand" />
            </Grid>
        </Border>

        <!-- ROW 2: NAVIGATION TABS -->
        <Border Grid.Row="2" Background="#1A1D27" Padding="16,8"
                BorderBrush="#2A2E3A" BorderThickness="0,0,0,1">
            <!-- Rounded "pill" container holds the top-nav tabs (reference style). The pill is a
                 container only; each tab keeps its own bottom-border active indicator, which the
                 code-behind SetTabActive/SetTabInactive toggles via Foreground + BorderBrush. -->
            <Border Background="#252A36" CornerRadius="8"
                    BorderBrush="#2A2E3A" BorderThickness="1" Padding="4"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <!-- Live tab (first). Status dot recolored in code-behind: gray when idle,
                         live pink when PresenterEngine.IsLive. Inline brushes only - this file
                         uses NO resource dictionaries. -->
                    <Button x:Name="TabLive" FontSize="12" FontWeight="SemiBold"
                            Padding="12,6" Margin="0,0,2,0" Background="Transparent" Foreground="#8B92A5"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Click="TabLive_Click" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LiveTabDot" Width="8" Height="8" Fill="#8B92A5"
                                     VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Live" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TabServices" Content="Services" FontSize="12" FontWeight="SemiBold"
                            Padding="12,6" Margin="0,0,2,0" Background="Transparent" Foreground="#00D4FF"
                            BorderBrush="#00D4FF" BorderThickness="0,0,0,2"
                            Click="TabServices_Click" Cursor="Hand" />
                    <Button x:Name="TabSongs" Content="Songs" FontSize="12" FontWeight="SemiBold"
                            Padding="12,6" Margin="0,0,2,0" Background="Transparent" Foreground="#8B92A5"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Click="TabSongs_Click" Cursor="Hand" />
                    <Button x:Name="TabScripture" Content="Scripture" FontSize="12" FontWeight="SemiBold"
                            Padding="12,6" Margin="0,0,2,0" Background="Transparent" Foreground="#8B92A5"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Click="TabScripture_Click" Cursor="Hand" />
                    <Button x:Name="TabMedia" Content="Media" FontSize="12" FontWeight="SemiBold"
                            Padding="12,6" Margin="0,0,2,0" Background="Transparent" Foreground="#8B92A5"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Click="TabMedia_Click" Cursor="Hand" />
                    <Button x:Name="TabTools" Content="Tools &#x25BE;" FontSize="12" FontWeight="SemiBold"
                            Padding="12,6" Background="Transparent" Foreground="#8B92A5"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            Click="TabTools_Click" Cursor="Hand">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ToolsContextMenu">
                                <MenuItem Header="Alert" Click="ToolAlert_Click" />
                                <MenuItem Header="Countdown" Click="ToolCountdown_Click" />
                                <MenuItem Header="Search" Click="ToolSearch_Click" />
                                <MenuItem Header="CCLI Report" Click="ToolCcliReport_Click" />
                                <MenuItem Header="Templates" Click="ToolTemplates_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- ROW 3: MAIN CONTENT -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border x:Name="ServiceOrderSidebar" Grid.Column="0" Background="#1A1D27"
                    BorderBrush="#2A2E3A" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,8,10,4">
                        <TextBlock Text="SERVICE ORDER" FontSize="9" FontWeight="Bold"
                                   Foreground="#4A5068" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- C2 Service order groups: add a collapsible named section. -->
                            <Button x:Name="AddGroupBtn" Content="&#xA7; Group" FontSize="9"
                                    Background="Transparent" Foreground="#00D4FF"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Padding="3,1" Margin="0,0,6,0" Click="AddGroup_Click"
                                    Cursor="Hand" ToolTip="Add a group section" />
                            <!-- C3 Bulk edit: toggle multi-select on item rows. -->
                            <ToggleButton x:Name="BulkEditToggle" Content="&#x2611; Bulk" FontSize="9"
                                    Background="Transparent" Foreground="#00D4FF"
                                    BorderBrush="Transparent" BorderThickness="0"
                                    Padding="3,1" Margin="0,0,6,0"
                                    Checked="BulkEditToggle_Checked" Unchecked="BulkEditToggle_Unchecked"
                                    Cursor="Hand" ToolTip="Toggle multi-select to batch-edit items" />
                            <Button x:Name="SidebarCollapseBtn" Content="&#x25C0;" FontSize="9"
                                    Background="Transparent"
                                    Foreground="#8B92A5" BorderBrush="Transparent" BorderThickness="0"
                                    Padding="3,1" Click="SidebarCollapse_Click" Cursor="Hand" />
                        </StackPanel>
                    </Grid>

                    <!-- Service order list - selectable ListBox. OperatorWindow uses NO resource
                         dictionaries (see note at top of file), so all brushes are hardcoded inline
                         here instead of referencing a StaticResource style, which would throw at load. -->
                    <ListBox x:Name="ServiceOrderList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#F0F2F5"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="ServiceOrderList_SelectionChanged"
                             MouseDoubleClick="ServiceOrderList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- Group-header row (C2): collapse chevron + name. Visible only
                                         when the display wrapper represents a group header. -->
                                    <StackPanel Orientation="Horizontal" Cursor="Hand"
                                                Visibility="{Binding HeaderVisibility}">
                                        <Button Content="{Binding CollapseGlyph}" FontSize="10"
                                                Background="Transparent" Foreground="#8B92A5"
                                                BorderBrush="Transparent" BorderThickness="0"
                                                Padding="8,4,4,4" Cursor="Hand"
                                                Click="GroupCollapseToggle_Click"
                                                Tag="{Binding}" />
                                        <TextBlock Text="{Binding Title}" FontSize="10" FontWeight="Bold"
                                                   Foreground="#4A5068" VerticalAlignment="Center"
                                                   Padding="0,4,10,4" />
                                    </StackPanel>
                                    <!-- Item row: icon + title (unchanged layout). -->
                                    <StackPanel Orientation="Horizontal" Cursor="Hand"
                                                Visibility="{Binding ItemVisibility}">
                                        <TextBlock Text="{Binding Icon}" FontSize="12" Foreground="#F0F2F5"
                                                   Padding="10,5,4,5" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#F0F2F5"
                                                   Padding="0,5,10,5" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <!-- Opened handler rebuilds the "Move to Group" submenu from the
                                 current groups and enables item actions only for item rows. -->
                            <ContextMenu Opened="ServiceOrderContextMenu_Opened">
                                <MenuItem Header="Edit" Click="EditServiceItem_Click" />
                                <MenuItem Header="Item Settings…" Click="ItemSettings_Click" />
                                <MenuItem x:Name="MoveToGroupMenu" Header="Move to Group" />
                                <MenuItem Header="Remove" Click="RemoveServiceItem_Click" />
                                <Separator />
                                <MenuItem Header="Add Group…" Click="AddGroup_Click" />
                                <MenuItem x:Name="RenameGroupMenu" Header="Rename Group…" Click="RenameGroup_Click" />
                                <MenuItem x:Name="DeleteGroupMenu" Header="Delete Group" Click="DeleteGroup_Click" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- Sidebar empty-state: dashed box + helper text, overlaid on the (empty)
                         service-order list. Stretched to the cell (NO fixed width) so a sidebar
                         collapse/expand does not misalign it. Inline brushes only. -->
                    <Grid x:Name="SidebarEmptyState" Grid.Row="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Top"
                          Margin="10,8,10,8">
                        <Rectangle Stroke="#2A2E3A" StrokeDashArray="4 3" StrokeThickness="1"
                                   RadiusX="6" RadiusY="6" Fill="Transparent" />
                        <TextBlock Text="To begin, select a service from the Services list. Your service items will appear here."
                                   Foreground="#8B92A5" FontSize="11" TextWrapping="Wrap"
                                   TextAlignment="Center" HorizontalAlignment="Stretch"
                                   VerticalAlignment="Center" Margin="16,20" />
                    </Grid>

                    <!-- Compact action toolbar (replaces the former tall stack of fat gray buttons).
                         A tidy WrapPanel of small chips. Every x:Name and Click handler is preserved;
                         item-level actions are also available via the ServiceOrderList context menu.
                         "+ Add" is the primary action (cyan); ApplyToSelectedBtn stays Collapsed and
                         the Bulk toggle flips its Visibility in code-behind. -->
                    <WrapPanel Grid.Row="2" Margin="8,6,8,8">
                        <Button Content="+ Add" Padding="8,5" Margin="0,0,4,4" FontSize="11" FontWeight="SemiBold"
                                Background="#252A36" Foreground="#00D4FF" BorderBrush="Transparent" BorderThickness="0"
                                Click="NewService_Click" Cursor="Hand" ToolTip="Add item" />
                        <Button Content="Edit" Padding="8,5" Margin="0,0,4,4" FontSize="11"
                                Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                                Click="EditServiceItem_Click" Cursor="Hand" ToolTip="Edit item" />
                        <Button Content="Settings" Padding="8,5" Margin="0,0,4,4" FontSize="11"
                                Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                                Click="ItemSettings_Click" Cursor="Hand" ToolTip="Item settings" />
                        <Button Content="Remove" Padding="8,5" Margin="0,0,4,4" FontSize="11"
                                Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                                Click="RemoveServiceItem_Click" Cursor="Hand" ToolTip="Remove item" />
                        <!-- C3 Bulk edit: visible only while the Bulk toggle is on. -->
                        <Button x:Name="ApplyToSelectedBtn" Content="Apply to selected…" Padding="8,5" Margin="0,0,4,4"
                                FontSize="11" Visibility="Collapsed"
                                Background="#252A36" Foreground="#00D4FF" BorderBrush="Transparent" BorderThickness="0"
                                Click="ApplyToSelected_Click" Cursor="Hand" />
                        <Button Content="Edit Service" Padding="8,5" Margin="0,0,4,4" FontSize="11"
                                Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                                Click="EditService_Click" Cursor="Hand" ToolTip="Edit service" />
                        <Button Content="Load Service" Padding="8,5" Margin="0,0,4,4" FontSize="11"
                                Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                                Click="LoadService_Click" Cursor="Hand" ToolTip="Load service" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- CENTER: SLIDE GRID + PANELS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Current item header -->
                <Border x:Name="CurrentItemHeader" Grid.Row="0" Background="#1A1D27" Padding="16,8"
                        BorderBrush="#2A2E3A" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CurrentItemTitle" Text="No Service Loaded"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#F0F2F5" />
                            <TextBlock x:Name="CurrentItemSubtitle" Text=""
                                       FontSize="10" Foreground="#8B92A5" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button x:Name="EditModeToggleBtn" Content="EDIT MODE: OFF"
                                HorizontalAlignment="Right" FontSize="9" FontWeight="SemiBold"
                                Background="#252A36" Foreground="#8B92A5" BorderBrush="Transparent" BorderThickness="0"
                                Padding="8,4" Click="EditModeToggle_Click" Cursor="Hand" />
                    </Grid>
                </Border>

                <!-- Content area (slides or panels) -->
                <Grid Grid.Row="1">
                    <!-- Home landing screen (default on startup). Inline brushes only -
                         OperatorWindow uses NO resource dictionaries. -->
                    <Border x:Name="HomePanel" Background="#0F1117">
                        <ContentPresenter x:Name="HomePanelContent" />
                    </Border>

                    <!-- Services-list table (shown by the Services top-nav tab) -->
                    <Border x:Name="ServicesListPanel" Visibility="Collapsed" Background="#0F1117">
                        <ContentPresenter x:Name="ServicesListPanelContent" />
                    </Border>

                    <!-- Services panel (slide grid - shown when a service is opened) -->
                    <Grid x:Name="ServicesPanel" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                            <Grid>
                                <TextBlock x:Name="EmptyStateText"
                                           Text="Load a song in the backtrack to see slides here.&#x0a;Or click 'Load Service' in the sidebar."
                                           FontSize="13" Foreground="#4A5068" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Margin="30" />
                                <WrapPanel x:Name="SlideThumbnailsPanel" Margin="6" />
                            </Grid>
                        </ScrollViewer>

                        <!-- Zoom slider -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Background="#1A1D27" CornerRadius="6" Padding="8,4" Margin="10"
                                BorderBrush="#2A2E3A" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Zoom" FontSize="9" Foreground="#8B92A5"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Slider x:Name="ZoomSlider" Width="100" Minimum="80" Maximum="800"
                                        Value="140" VerticalAlignment="Center"
                                        ValueChanged="ZoomSlider_ValueChanged" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Other panels (hidden by default) -->
                    <Border x:Name="SongsPanel" Visibility="Collapsed" Background="#0F1117">
                        <ContentPresenter x:Name="SongsPanelContent" />
                    </Border>
                    <Border x:Name="ScripturePanel" Visibility="Collapsed" Background="#0F1117">
                        <ContentPresenter x:Name="ScripturePanelContent" />
                    </Border>
                    <Border x:Name="MediaPanel" Visibility="Collapsed" Background="#0F1117">
                        <ContentPresenter x:Name="MediaPanelContent" />
                    </Border>
                    <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#0F1117" Padding="30">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Unable to load panel" FontSize="16" FontWeight="SemiBold"
                                       Foreground="#F0F2F5" TextAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock x:Name="ErrorPanelMessage" Text="" FontSize="12"
                                       Foreground="#8B92A5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="350" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ROW 4: TRANSPORT BAR -->
        <Border Grid.Row="4" Background="#1A1D27" Padding="16,0"
                BorderBrush="#2A2E3A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SlideCounterText" Grid.Column="0" Text="Slide 0 / 0"
                           FontSize="12" FontWeight="SemiBold" Foreground="#F0F2F5"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="&#x25C0; PREV" Padding="10,6" Margin="2,0" FontSize="11" FontWeight="SemiBold"
                            Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                            Click="PrevSlide_Click" Cursor="Hand" />
                    <Button Content="NEXT &#x25B6;" Padding="10,6" Margin="2,0" FontSize="11" FontWeight="Bold"
                            Background="#00D4FF" Foreground="#0F1117" BorderBrush="Transparent" BorderThickness="0"
                            Click="NextSlide_Click" Cursor="Hand" />
                    <Button Content="BLACK" Padding="10,6" Margin="8,0,2,0" FontSize="11" FontWeight="SemiBold"
                            Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                            Click="GoBlack_Click" Cursor="Hand" />
                    <Button x:Name="LiveButton" Content="GO LIVE" Padding="10,6" Margin="2,0" FontSize="11" FontWeight="Bold"
                            Background="#FF3366" Foreground="White" BorderBrush="Transparent" BorderThickness="0"
                            Click="GoLive_Click" Cursor="Hand" />
                    <Button Content="LOGO" Padding="10,6" Margin="2,0" FontSize="11" FontWeight="SemiBold"
                            Background="#252A36" Foreground="#F0F2F5" BorderBrush="Transparent" BorderThickness="0"
                            Click="ShowLogo_Click" Cursor="Hand" />
                    <Button x:Name="ChordsToggleBtn" Content="CHORDS: OFF" Padding="10,6" Margin="2,0" FontSize="11"
                            Background="#252A36" Foreground="#8B92A5" BorderBrush="Transparent" BorderThickness="0"
                            Click="ToggleChords_Click" Cursor="Hand" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#252A36" CornerRadius="6" Padding="8,4" Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="BacktrackStatusText" Text="Not Connected"
                                       FontSize="9" FontWeight="Bold" Foreground="#FFAB00"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="BacktrackSongText" Text="" FontSize="10"
                                       Foreground="#F0F2F5" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="BacktrackSectionText" Text="" FontSize="9"
                                       Foreground="#8B92A5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#252A36" CornerRadius="6" Padding="6,4" Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="KEY" FontSize="8" Foreground="#4A5068" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock x:Name="KeyInfoText" Text="-" FontSize="10" FontWeight="Bold" Foreground="#F0F2F5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="CAPO" FontSize="8" Foreground="#4A5068" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock x:Name="CapoInfoText" Text="-" FontSize="10" FontWeight="Bold" Foreground="#F0F2F5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="TEMPO" FontSize="8" Foreground="#4A5068" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock x:Name="TempoInfoText" Text="-" FontSize="10" FontWeight="Bold" Foreground="#F0F2F5" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="PITCH" FontSize="8" Foreground="#4A5068" VerticalAlignment="Center" Margin="0,0,2,0" />
                            <TextBlock x:Name="PitchInfoText" Text="-" FontSize="10" FontWeight="Bold" Foreground="#F0F2F5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hidden for API compat -->
        <TextBox x:Name="NotesBox" Visibility="Collapsed" />
    </Grid>
</Window>
