<Window x:Class="WorshipPlayer.Presenter.Views.Slides.SlideServiceItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorshipPlayer.Presenter.Views.Slides"
        Title="Edit Service Item"
        Width="760" Height="780"
        MinWidth="640" MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">

        <!-- ─── Header ──────────────────────────────────────────────── -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Remove service item" Style="{StaticResource OwcButtonBase}"
                        Click="Remove_Click" MinWidth="140" Margin="0,0,8,0"/>
                <Button Content="Close" Style="{StaticResource OwcButtonBase}"
                        Click="Close_Click" MinWidth="80" Margin="0,0,8,0"/>
                <Button x:Name="SaveButton" Content="Save and close"
                        Style="{StaticResource OwcBlueButton}"
                        Click="SaveAndClose_Click" MinWidth="120" IsEnabled="False"/>
            </StackPanel>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SERVICE ITEM" Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <StackPanel x:Name="NameDisplayPanel" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="NameTextBlock" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource OwcTextPrimaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="360"/>
                    <Button x:Name="RenameButton" Content="✎" Style="{StaticResource OwcCompactButton}"
                            Click="Rename_Click" Margin="8,0,0,0" MinWidth="30"
                            ToolTip="Rename"/>
                </StackPanel>
                <StackPanel x:Name="NameEditPanel" Orientation="Horizontal"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBox x:Name="NameEditBox" Style="{StaticResource OwcTextBox}"
                             FontSize="16" MinWidth="280" VerticalAlignment="Center"/>
                    <Button Content="OK" Style="{StaticResource OwcBlueButton}"
                            Click="RenameConfirm_Click" Margin="8,0,0,0" MinWidth="48"/>
                    <Button Content="Cancel" Style="{StaticResource OwcButtonBase}"
                            Click="RenameCancel_Click" Margin="6,0,0,0" MinWidth="60"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- ─── Body ────────────────────────────────────────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- Slides (linked presentation) -->
                <Border Style="{StaticResource OwcPanelBorder}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="EditSlidesButton" Content="Edit slides"
                                    Style="{StaticResource OwcCompactButton}"
                                    Click="EditSlides_Click" MinWidth="96" Margin="0,0,6,0"/>
                            <Button Content="Select"
                                    Style="{StaticResource OwcCompactButton}"
                                    Click="SelectPresentation_Click" MinWidth="80"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="SLIDES" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock x:Name="LinkedPresentationText" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="(no presentation linked)"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Background media -->
                <Border Style="{StaticResource OwcPanelBorder}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="BACKGROUND MEDIA" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBlock Text="Source" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SourceComboBox" Style="{StaticResource OwcDarkComboBox}"
                                  SelectionChanged="SourceComboBox_SelectionChanged"
                                  DisplayMemberPath="Label" MinWidth="320" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Auto-advance -->
                <Border Style="{StaticResource OwcPanelBorder}" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AUTO-ADVANCE" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Go to next slide after"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox x:Name="AfterComboBox" Style="{StaticResource OwcDarkComboBox}"
                                          SelectionChanged="AfterComboBox_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="When complete"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,0,4"/>
                                <ComboBox x:Name="WhenCompleteComboBox" Style="{StaticResource OwcDarkComboBox}"
                                          SelectionChanged="WhenCompleteComboBox_SelectionChanged"/>
                            </StackPanel>
                        </Grid>

                        <!-- Delay field (only for Time Delay) -->
                        <StackPanel x:Name="DelayPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Delay (ms)"
                                       Foreground="{StaticResource OwcTextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="DelayTextBox" Style="{StaticResource OwcTextBox}"
                                     MinWidth="140" HorizontalAlignment="Left"
                                     TextChanged="DelayTextBox_TextChanged"/>
                        </StackPanel>

                        <!-- Target item (only for Specific item) -->
                        <StackPanel x:Name="TargetPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="Target item"
                                       Foreground="{StaticResource OwcTextSecondaryBrush}"
                                       FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="TargetComboBox" Style="{StaticResource OwcDarkComboBox}"
                                      SelectionChanged="TargetComboBox_SelectionChanged"
                                      DisplayMemberPath="Label" MinWidth="320" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Settings row: Transitions + Audio -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Transitions -->
                    <Border Grid.Column="0" Style="{StaticResource OwcPanelBorder}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="TRANSITIONS" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock DockPanel.Dock="Right" x:Name="TransitionValueText"
                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                           FontSize="12" Text="500 ms"/>
                                <TextBlock Text="Fade time"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                           FontSize="12"/>
                            </DockPanel>
                            <Slider x:Name="TransitionSlider" Style="{StaticResource OwcSlider}"
                                    Minimum="0" Maximum="3000" TickFrequency="100"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="TransitionSlider_ValueChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Audio -->
                    <Border Grid.Column="2" Style="{StaticResource OwcPanelBorder}" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="+"
                                        Style="{StaticResource OwcBlueButton}"
                                        FontSize="16" FontWeight="Bold"
                                        Width="32" Height="28" Padding="0"
                                        Click="AddAudio_Click" ToolTip="Add audio file"/>
                                <TextBlock Text="AUDIO" Foreground="{StaticResource OwcTextSecondaryBrush}"
                                           FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="AudioEmptyText" Text="No audio files added"
                                       Foreground="{StaticResource OwcTextSecondaryBrush}"
                                       FontSize="12"/>
                            <ItemsControl x:Name="AudioItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource OwcSurfaceBrush}"
                                                CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕"
                                                        Style="{StaticResource OwcCompactButton}"
                                                        Click="RemoveAudio_Click"
                                                        Tag="{Binding Path}"
                                                        MinWidth="28" Margin="6,0,0,0"
                                                        ToolTip="Remove"/>
                                                <TextBlock Text="{Binding Path}"
                                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Stage Display Template -->
                <Border Style="{StaticResource OwcPanelBorder}" Padding="14" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Text="STAGE DISPLAY TEMPLATE"
                                   Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="Select" Style="{StaticResource OwcCompactButton}"
                                        Click="SelectTemplate_Click" MinWidth="80" Margin="0,0,6,0"/>
                                <Button x:Name="ClearTemplateButton" Content="Clear"
                                        Style="{StaticResource OwcButtonBase}"
                                        Click="ClearTemplate_Click" MinWidth="70"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="140" Height="78" CornerRadius="8"
                                        Background="{StaticResource OwcSurfaceBrush}"
                                        BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1">
                                    <StackPanel VerticalAlignment="Center" Margin="8">
                                        <TextBlock x:Name="TemplateTileName" Text="Aa"
                                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                                   FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TemplateTileDescriptor" Text=""
                                                   Foreground="{StaticResource OwcTextSecondaryBrush}"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="TemplateLabel" Text="No template selected"
                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                           FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
