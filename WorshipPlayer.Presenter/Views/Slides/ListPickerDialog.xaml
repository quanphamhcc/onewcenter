<Window x:Class="WorshipPlayer.Presenter.Views.Slides.ListPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorshipPlayer.Presenter.Views.Slides"
        Title="Select"
        Width="420" Height="520"
        MinWidth="320" MinHeight="320"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top"
                   Text="Select an item"
                   Foreground="{StaticResource OwcTextSecondaryBrush}"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource OwcButtonBase}"
                    Click="Cancel_Click" MinWidth="80" Margin="0,0,8,0"/>
            <Button Content="Select" Style="{StaticResource OwcBlueButton}"
                    Click="Select_Click" MinWidth="80"/>
        </StackPanel>

        <Border Style="{StaticResource OwcPanelBorder}" Padding="8">
            <ListBox x:Name="ItemsListBox"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource OwcTextPrimaryBrush}"
                     HorizontalContentAlignment="Stretch"
                     DisplayMemberPath="Label"
                     MouseDoubleClick="ItemsListBox_MouseDoubleClick"/>
        </Border>
    </DockPanel>
</Window>
