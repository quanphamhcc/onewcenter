<Window x:Class="WorshipPlayer.Presenter.Views.Slides.SlideNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Slides"
        SizeToContent="Height"
        MinWidth="380" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="20">
        <!-- Bottom buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource OwcButtonBase}"
                    Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80"/>
            <Button x:Name="OkButton" Content="Create" Style="{StaticResource OwcBlueButton}"
                    Click="Ok_Click" MinWidth="100"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Presentation name" Foreground="{StaticResource OwcTextSecondaryBrush}"
                       FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="NameTextBox" Style="{StaticResource OwcTextBox}"
                     Text="New Presentation"
                     TextChanged="NameTextBox_TextChanged"/>
        </StackPanel>
    </DockPanel>
</Window>
