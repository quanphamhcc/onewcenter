<UserControl x:Class="WorshipPlayer.Presenter.Views.Tools.GlobalSearchPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="12">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top" Text="Search"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,8"/>

            <!-- Search Input -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox x:Name="SearchTextBox"
                         Background="{StaticResource OwcSurfaceBrush}"
                         Foreground="{StaticResource OwcTextPrimaryBrush}"
                         BorderBrush="{StaticResource OwcBorderBrush}"
                         FontSize="13" Padding="30,8,8,8"
                         TextChanged="SearchTextBox_TextChanged"/>
                <!-- Search icon placeholder -->
                <TextBlock Text="&#x1F50D;" FontSize="13"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{StaticResource OwcTextMutedBrush}"/>
            </Grid>

            <!-- Results Area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock x:Name="EmptyStateText"
                               Text="Type to search across songs, services, and slides."
                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Margin="4,20" HorizontalAlignment="Center"
                               Visibility="Visible"/>

                    <!-- Songs Section -->
                    <StackPanel x:Name="SongsSection" Visibility="Collapsed">
                        <TextBlock Text="Songs" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource OwcAccentBrush}"
                                   Margin="0,8,0,4"/>
                        <ItemsControl x:Name="SongsResults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="6,5"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Edit"
                                                        Style="{StaticResource OwcButtonBase}"
                                                        FontSize="10" Padding="6,3" Margin="0,0,4,0"
                                                        Tag="{Binding Id}"
                                                        Click="EditResult_Click"/>
                                                <Button Content="Delete"
                                                        Style="{StaticResource OwcButtonBase}"
                                                        FontSize="10" Padding="6,3"
                                                        Tag="{Binding Id}"
                                                        Click="DeleteResult_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Services Section -->
                    <StackPanel x:Name="ServicesSection" Visibility="Collapsed">
                        <TextBlock Text="Services" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource OwcAccentBrush}"
                                   Margin="0,8,0,4"/>
                        <ItemsControl x:Name="ServicesResults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="6,5"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Edit"
                                                        Style="{StaticResource OwcButtonBase}"
                                                        FontSize="10" Padding="6,3" Margin="0,0,4,0"
                                                        Tag="{Binding Id}"
                                                        Click="EditResult_Click"/>
                                                <Button Content="Delete"
                                                        Style="{StaticResource OwcButtonBase}"
                                                        FontSize="10" Padding="6,3"
                                                        Tag="{Binding Id}"
                                                        Click="DeleteResult_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Slides Section -->
                    <StackPanel x:Name="SlidesSection" Visibility="Collapsed">
                        <TextBlock Text="Slides" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource OwcAccentBrush}"
                                   Margin="0,8,0,4"/>
                        <ItemsControl x:Name="SlidesResults">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="6,5"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Title}"
                                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                                           FontSize="12"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="Edit"
                                                        Style="{StaticResource OwcButtonBase}"
                                                        FontSize="10" Padding="6,3" Margin="0,0,4,0"
                                                        Tag="{Binding Id}"
                                                        Click="EditResult_Click"/>
                                                <Button Content="Delete"
                                                        Style="{StaticResource OwcButtonBase}"
                                                        FontSize="10" Padding="6,3"
                                                        Tag="{Binding Id}"
                                                        Click="DeleteResult_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- No results state -->
                    <TextBlock x:Name="NoResultsText"
                               Text="No results found."
                               Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Margin="4,20" HorizontalAlignment="Center"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
