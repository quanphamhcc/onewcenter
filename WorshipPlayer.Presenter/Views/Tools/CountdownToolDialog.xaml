<Window x:Class="WorshipPlayer.Presenter.Views.Tools.CountdownToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Countdown Tool" Width="550" Height="520"
        MinWidth="450" MinHeight="450"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Countdown Timer"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Type Selector -->
        <Border Grid.Row="1" Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Countdown Type" FontSize="11"
                           Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="TypeComboBox"
                          Background="{StaticResource OwcSurfaceBrush}"
                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                          FontSize="12" Padding="8,6"
                          SelectionChanged="TypeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Countdown to Zero" IsSelected="True"/>
                    <ComboBoxItem Content="Countdown to Time"/>
                    <ComboBoxItem Content="Count Up"/>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Duration Input -->
        <Border Grid.Row="2" Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Duration (HH:MM:SS)" FontSize="11"
                           Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="HoursTextBox" Text="00" Width="50"
                             Background="{StaticResource OwcSurfaceBrush}"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             BorderBrush="{StaticResource OwcBorderBrush}"
                             FontSize="16" FontWeight="Bold" Padding="8,6"
                             TextAlignment="Center" MaxLength="2"/>
                    <TextBlock Text=":" Foreground="{StaticResource OwcTextPrimaryBrush}"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="4,0"/>
                    <TextBox x:Name="MinutesTextBox" Text="05" Width="50"
                             Background="{StaticResource OwcSurfaceBrush}"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             BorderBrush="{StaticResource OwcBorderBrush}"
                             FontSize="16" FontWeight="Bold" Padding="8,6"
                             TextAlignment="Center" MaxLength="2"/>
                    <TextBlock Text=":" Foreground="{StaticResource OwcTextPrimaryBrush}"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="4,0"/>
                    <TextBox x:Name="SecondsTextBox" Text="00" Width="50"
                             Background="{StaticResource OwcSurfaceBrush}"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             BorderBrush="{StaticResource OwcBorderBrush}"
                             FontSize="16" FontWeight="Bold" Padding="8,6"
                             TextAlignment="Center" MaxLength="2"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Location & Font Settings -->
        <Border Grid.Row="3" Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Location -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Display Location" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <CheckBox x:Name="AudienceCheckBox" Content="Audience"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Margin="0,0,0,4" IsChecked="True"/>
                    <CheckBox x:Name="StageCheckBox" Content="Stage"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" IsChecked="True"/>
                </StackPanel>

                <!-- Font -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Font Settings" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="FontFamilyComboBox"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="11" Padding="4,3" Margin="0,0,0,4">
                        <ComboBoxItem Content="Segoe UI" IsSelected="True"/>
                        <ComboBoxItem Content="Arial"/>
                        <ComboBoxItem Content="Consolas"/>
                        <ComboBoxItem Content="Impact"/>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FontColorTextBox" Text="#FFFFFF" Width="70"
                                 Background="{StaticResource OwcSurfaceBrush}"
                                 Foreground="{StaticResource OwcTextPrimaryBrush}"
                                 BorderBrush="{StaticResource OwcBorderBrush}"
                                 FontSize="11" Padding="4,3"/>
                        <Border Width="20" Height="20"
                                Background="#FFFFFF" CornerRadius="3" Margin="6,0,0,0"
                                BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Live Preview -->
        <Border Grid.Row="4" Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Preview" FontSize="11"
                           Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                <Border Background="#000000" CornerRadius="4" Padding="16,12">
                    <TextBlock x:Name="PreviewTimeText" Text="05:00"
                               FontSize="36" FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Spacer -->
        <Grid Grid.Row="5"/>

        <!-- Control Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CloseButton" Content="Close"
                    Style="{StaticResource OwcButtonBase}"
                    Padding="16,8" Margin="0,0,8,0"
                    Click="CloseButton_Click"/>
            <Button x:Name="PauseButton" Content="Pause"
                    Style="{StaticResource OwcButtonBase}"
                    Padding="16,8" Margin="0,0,8,0"
                    Click="PauseButton_Click" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="Stop"
                    Style="{StaticResource OwcButtonBase}"
                    Padding="16,8" Margin="0,0,8,0"
                    Click="StopButton_Click" IsEnabled="False"/>
            <Button x:Name="StartButton" Content="Start"
                    Style="{StaticResource OwcAccentButton}"
                    Padding="16,8"
                    Click="StartButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
