<Window x:Class="WorshipPlayer.Presenter.Views.Tools.CcliReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCLI Song Usage Report" Width="800" Height="600"
        MinWidth="700" MinHeight="500"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1117"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="CCLI Song Usage Report"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Date Range / Generate -->
        <Border Grid.Row="1" Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="From" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="FromDatePicker"
                                Background="{StaticResource OwcSurfaceBrush}"
                                Foreground="{StaticResource OwcTextPrimaryBrush}"
                                BorderBrush="{StaticResource OwcBorderBrush}"
                                FontSize="12" Width="140"/>
                </StackPanel>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="To" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="ToDatePicker"
                                Background="{StaticResource OwcSurfaceBrush}"
                                Foreground="{StaticResource OwcTextPrimaryBrush}"
                                BorderBrush="{StaticResource OwcBorderBrush}"
                                FontSize="12" Width="140"/>
                </StackPanel>

                <Button x:Name="GenerateButton" Content="Generate Report"
                        Style="{StaticResource OwcAccentButton}"
                        FontSize="12" Padding="12,6"
                        VerticalAlignment="Bottom" Margin="0,0,0,1"
                        Click="GenerateButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Results DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource OwcSurfaceBorder}" Padding="0">
            <Grid>
                <!-- Empty state -->
                <TextBlock x:Name="EmptyStateText"
                           Text="Select a date range and click Generate to view song usage."
                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Visible"/>

                <!-- DataGrid -->
                <DataGrid x:Name="ReportDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Background="{StaticResource OwcSurfaceBrush}"
                          Foreground="{StaticResource OwcTextPrimaryBrush}"
                          BorderBrush="{StaticResource OwcBorderBrush}"
                          RowBackground="{StaticResource OwcSurfaceBrush}"
                          AlternatingRowBackground="{StaticResource OwcPanelBrush}"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource OwcBorderBrush}"
                          HeadersVisibility="Column"
                          CanUserSortColumns="True"
                          Visibility="Collapsed">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource OwcPanelBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OwcTextSecondaryBrush}"/>
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontSize" Value="11"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="150"/>
                        <DataGridTextColumn Header="Times Played" Binding="{Binding TimesPlayed}" Width="100"/>
                        <DataGridTextColumn Header="Last Played" Binding="{Binding LastPlayed, StringFormat=d}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ExportCsvButton" Content="Export CSV"
                    Style="{StaticResource OwcButtonBase}"
                    Padding="16,8" Margin="0,0,8,0"
                    Click="ExportCsvButton_Click" IsEnabled="False"/>
            <Button x:Name="CloseButton" Content="Close"
                    Style="{StaticResource OwcButtonBase}"
                    Padding="16,8"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
