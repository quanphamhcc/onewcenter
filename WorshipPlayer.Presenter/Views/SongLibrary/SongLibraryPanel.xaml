<UserControl x:Class="WorshipPlayer.Presenter.Views.SongLibrary.SongLibraryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="12">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top" Text="Song Library"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <!-- Toolbar: Filters (combos + sort) + Search (left), + Add Song (right) -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Non-interactive "Filters" label for the ProPresenter-style grouping -->
                    <TextBlock Text="Filters" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}"/>

                    <ComboBox x:Name="KeyFilterComboBox"
                              Style="{StaticResource OwcDarkComboBox}"
                              Width="110" Height="32" VerticalAlignment="Center" Margin="0,0,8,0"
                              FontSize="11" Padding="6,4"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Keys" IsSelected="True"/>
                        <ComboBoxItem Content="C"/><ComboBoxItem Content="C#"/>
                        <ComboBoxItem Content="D"/><ComboBoxItem Content="D#"/>
                        <ComboBoxItem Content="E"/><ComboBoxItem Content="F"/>
                        <ComboBoxItem Content="F#"/><ComboBoxItem Content="G"/>
                        <ComboBoxItem Content="G#"/><ComboBoxItem Content="A"/>
                        <ComboBoxItem Content="A#"/><ComboBoxItem Content="B"/>
                        <ComboBoxItem Content="Cm"/><ComboBoxItem Content="Dm"/>
                        <ComboBoxItem Content="Em"/><ComboBoxItem Content="Fm"/>
                        <ComboBoxItem Content="Gm"/><ComboBoxItem Content="Am"/>
                        <ComboBoxItem Content="Bm"/>
                    </ComboBox>

                    <ComboBox x:Name="ArtistFilterComboBox"
                              Style="{StaticResource OwcDarkComboBox}"
                              Width="130" Height="32" VerticalAlignment="Center" Margin="0,0,8,0"
                              FontSize="11" Padding="6,4"
                              SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Artists" IsSelected="True"/>
                    </ComboBox>

                    <Button x:Name="SortAZButton" Content="A-Z"
                            Style="{StaticResource OwcButtonBase}"
                            FontSize="10" Padding="8,4" Height="32" VerticalAlignment="Center" Margin="0,0,4,0"
                            Click="SortAZ_Click"/>
                    <Button x:Name="SortDateButton" Content="Date"
                            Style="{StaticResource OwcButtonBase}"
                            FontSize="10" Padding="8,4" Height="32" VerticalAlignment="Center" Margin="0,0,12,0"
                            Click="SortDate_Click"/>

                    <!-- Search box (wide) -->
                    <TextBox x:Name="SearchTextBox"
                             Style="{StaticResource OwcTextBox}"
                             Width="260" Height="32" VerticalAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>

                <!-- Prominent blue CTA. Reuses the existing ChordPro import handler
                     (ImportChordPro_Click → ImportChordProRequested → host import + RefreshSongs). -->
                <Button x:Name="ImportChordProButton"
                        Content="+ Add Song"
                        Style="{StaticResource OwcBlueButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="110" Height="32"
                        Click="ImportChordPro_Click"/>
            </Grid>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyStateText" DockPanel.Dock="Top"
                       Text="No songs found. Import songs to get started."
                       Foreground="{StaticResource OwcTextSecondaryBrush}"
                       FontSize="12" TextWrapping="Wrap"
                       Margin="4,20" HorizontalAlignment="Center"
                       Visibility="Visible"/>

            <!-- Song table -->
            <ListView x:Name="SongListBox"
                      Style="{StaticResource OwcDarkListView}"
                      SelectionChanged="SongList_SelectionChanged"
                      Visibility="Collapsed">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource OwcDarkGridViewColumnHeader}">
                        <!-- Leading select checkbox (placeholder affordance, unbound) -->
                        <GridViewColumn Header="" Width="36">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Song: bold title + muted artist second line (blank if none) -->
                        <GridViewColumn Header="Song" Width="240">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,6">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                                   FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource OwcTextSecondaryBrush}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Key (real) -->
                        <GridViewColumn Header="Key" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Key}" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource OwcTextPrimaryBrush}" Padding="8,8"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Last modified (derived from folder timestamp, or "—") -->
                        <GridViewColumn Header="Last modified" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastModifiedDisplay}" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource OwcTextSecondaryBrush}" Padding="8,8"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Last modified by (placeholder "Local") -->
                        <GridViewColumn Header="Last modified by" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastModifiedBy}" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource OwcTextSecondaryBrush}" Padding="8,8"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Per-row blue "+ Add" (adds to service; does not change selection) -->
                        <GridViewColumn Header="" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+ Add"
                                            Style="{StaticResource OwcBlueButton}"
                                            FontSize="10" Padding="8,4"
                                            VerticalAlignment="Center"
                                            Tag="{Binding}"
                                            Click="AddToService_Click"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Per-row ⋮ overflow: Edit Metadata… / Edit Slides… -->
                        <GridViewColumn Header="" Width="44">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#x22EE;" Style="{StaticResource OwcButtonBase}"
                                            Background="Transparent" Padding="6,2" FontSize="16"
                                            VerticalAlignment="Center"
                                            Click="Overflow_Click">
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Edit Metadata…" Click="EditMetadataMenu_Click" Tag="{Binding}"/>
                                                <MenuItem Header="Edit Slides…" Click="EditSlidesMenu_Click" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
