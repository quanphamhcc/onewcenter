<UserControl x:Class="WorshipPlayer.Presenter.Views.SongLibrary.SongSlideEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource OwcPanelBorder}" Padding="12">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top" Text="Song Slide Editor"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,10"/>

            <!-- Bottom buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Cancel" Style="{StaticResource OwcButtonBase}"
                        Click="Cancel_Click" Margin="0,0,8,0" MinWidth="80"/>
                <Button Content="Save" Style="{StaticResource OwcAccentButton}"
                        Click="Save_Click" MinWidth="80"/>
            </StackPanel>

            <!-- Content Grid: section list | editor | preview -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: section list -->
                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="Slides" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,4"/>
                    <ListBox x:Name="SectionListBox"
                             Style="{StaticResource OwcServiceListBox}"
                             DisplayMemberPath="Name"
                             MinHeight="150"
                             SelectionChanged="SectionList_SelectionChanged"/>
                </DockPanel>

                <!-- Middle: editor -->
                <StackPanel Grid.Column="2">
                    <!-- Lyrics -->
                    <TextBlock Text="Lyrics" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,4"/>
                    <TextBox x:Name="LyricsTextBox"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="150" MaxHeight="250"
                             VerticalScrollBarVisibility="Auto"
                             Background="{StaticResource OwcSurfaceBrush}"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             BorderBrush="{StaticResource OwcBorderBrush}"
                             FontSize="13" Padding="8,6"
                             Margin="0,0,0,12"
                             IsEnabled="False"
                             TextChanged="Lyrics_TextChanged"/>

                    <!-- Background per slide -->
                    <TextBlock Text="Background" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="BackgroundComboBox"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Padding="8,6" Margin="0,0,0,12"
                              IsEnabled="False"
                              DisplayMemberPath="Display"
                              SelectionChanged="Background_SelectionChanged"/>

                    <!-- Template -->
                    <TextBlock Text="Template" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TemplateComboBox"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Padding="8,6"
                              IsEnabled="False"
                              DisplayMemberPath="Display"
                              SelectionChanged="Template_SelectionChanged"/>
                </StackPanel>

                <!-- Right: Preview -->
                <Border Grid.Column="4" Style="{StaticResource OwcSurfaceBorder}"
                        Padding="12" MinHeight="200">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Preview"
                                   Foreground="{StaticResource OwcTextSecondaryBrush}"
                                   FontSize="11" Margin="0,0,0,8"/>
                        <TextBlock x:Name="PreviewText"
                                   Text="Select a slide to edit"
                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                   FontSize="14" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
