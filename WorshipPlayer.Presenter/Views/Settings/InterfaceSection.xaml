<UserControl x:Class="WorshipPlayer.Presenter.Views.Settings.InterfaceSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Section Title -->
            <TextBlock Text="Interface" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Editor Background Color -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Editor Background Color" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="EditorBgColorTextBox" Text="#0F1117"
                                 Background="{StaticResource OwcSurfaceBrush}"
                                 Foreground="{StaticResource OwcTextPrimaryBrush}"
                                 BorderBrush="{StaticResource OwcBorderBrush}"
                                 FontSize="12" Padding="8,6" Width="100"/>
                        <Border x:Name="EditorBgColorSwatch" Width="32" Height="32"
                                Background="#0F1117" CornerRadius="4" Margin="8,0,0,0"
                                BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1"/>
                    </StackPanel>
                    <TextBlock Text="Controls the background color of the slide editor and preview areas."
                               FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Media Load Behavior -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Media Load Behavior" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MediaLoadComboBox"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Padding="8,6">
                        <ComboBoxItem Content="Copy to Library" IsSelected="True"/>
                        <ComboBoxItem Content="Link in Place"/>
                    </ComboBox>
                    <TextBlock Text="Copy to Library: Media files are copied into the library folder. Link in Place: Files remain at their original location."
                               FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
