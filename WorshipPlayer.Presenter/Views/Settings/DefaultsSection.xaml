<UserControl x:Class="WorshipPlayer.Presenter.Views.Settings.DefaultsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Section Title -->
            <TextBlock Text="Defaults" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Fade Time -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Fade Time (ms)" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FadeTimeSlider" Grid.Column="0"
                                Minimum="0" Maximum="3000" Value="500"
                                Style="{StaticResource OwcSlider}"
                                ValueChanged="FadeTime_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="FadeTimeDisplay" Text="500ms"
                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                   FontSize="12" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Aspect Ratio -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Aspect Ratio" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="AspectRatioComboBox"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Padding="8,6">
                        <ComboBoxItem Content="16:9" IsSelected="True"/>
                        <ComboBoxItem Content="4:3"/>
                        <ComboBoxItem Content="Custom"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Default Template -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Default Template" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="DefaultTemplateComboBox"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Padding="8,6">
                        <ComboBoxItem Content="Default Centered" IsSelected="True"/>
                        <ComboBoxItem Content="Lower Third"/>
                        <ComboBoxItem Content="Trendy Line"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Auto-fire / Auto-advance -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Automation" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoFireToggle" Content="Auto-fire (advance on item select)"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Margin="0,0,0,8"/>
                    <CheckBox x:Name="AutoAdvanceToggle" Content="Auto-advance slides"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Auto-Timed Slides (lyric grouping + vocal timing) -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Auto-Timed Slides" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>

                    <TextBlock Text="Lines per slide" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LinesPerSlideComboBox"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Padding="8,6" Margin="0,0,0,10">
                        <ComboBoxItem Content="2 lines" Tag="2"/>
                        <ComboBoxItem Content="3 lines" Tag="3"/>
                        <ComboBoxItem Content="4 lines" Tag="4" IsSelected="True"/>
                    </ComboBox>

                    <TextBlock Text="Slide lead time (ms before first word is sung)" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SlideLeadSlider" Grid.Column="0"
                                Minimum="0" Maximum="1500" Value="500"
                                Style="{StaticResource OwcSlider}"
                                ValueChanged="SlideLead_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="SlideLeadDisplay" Text="500ms"
                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                   FontSize="12" HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Used when Auto-Detect groups lyrics into slides and times them to the vocals. A section can override the line count individually."
                               FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Media Defaults -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Media Defaults" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Default media settings are applied when new media items are added to the service."
                               FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
