<UserControl x:Class="WorshipPlayer.Presenter.Views.Settings.FooterSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Section Title -->
            <TextBlock Text="Footer Settings" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- CCLI License # -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="CCLI License Number" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox x:Name="CcliNumberTextBox"
                             Background="{StaticResource OwcSurfaceBrush}"
                             Foreground="{StaticResource OwcTextPrimaryBrush}"
                             BorderBrush="{StaticResource OwcBorderBrush}"
                             FontSize="12" Padding="8,6"/>
                </StackPanel>
            </Border>

            <!-- Footer Location -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Footer Location" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="LocationComboBox"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Padding="8,6">
                        <ComboBoxItem Content="Bottom Left"/>
                        <ComboBoxItem Content="Bottom Center" IsSelected="True"/>
                        <ComboBoxItem Content="Bottom Right"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Font Settings -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Font Settings" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="FontFamilyComboBox" Grid.Column="0"
                                  Background="{StaticResource OwcSurfaceBrush}"
                                  Foreground="{StaticResource OwcTextPrimaryBrush}"
                                  FontSize="12" Padding="6,4">
                            <ComboBoxItem Content="Segoe UI" IsSelected="True"/>
                            <ComboBoxItem Content="Arial"/>
                            <ComboBoxItem Content="Calibri"/>
                            <ComboBoxItem Content="Verdana"/>
                        </ComboBox>

                        <TextBox x:Name="FontSizeTextBox" Grid.Column="2" Text="14"
                                 Background="{StaticResource OwcSurfaceBrush}"
                                 Foreground="{StaticResource OwcTextPrimaryBrush}"
                                 BorderBrush="{StaticResource OwcBorderBrush}"
                                 FontSize="12" Padding="6,4"/>

                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <TextBox x:Name="FontColorTextBox" Text="#FFFFFF" Width="70"
                                     Background="{StaticResource OwcSurfaceBrush}"
                                     Foreground="{StaticResource OwcTextPrimaryBrush}"
                                     BorderBrush="{StaticResource OwcBorderBrush}"
                                     FontSize="12" Padding="4,4"/>
                            <Border Width="24" Height="24"
                                    Background="#FFFFFF" CornerRadius="4" Margin="4,0,0,0"
                                    BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Show On -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Show Footer On" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowOnLyricsCheckBox" Content="Lyrics slides"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Margin="0,0,0,6" IsChecked="True"/>
                    <CheckBox x:Name="ShowOnScriptureCheckBox" Content="Scripture slides"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12" Margin="0,0,0,6" IsChecked="True"/>
                    <CheckBox x:Name="ShowOnAllCheckBox" Content="All slides"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
