<UserControl x:Class="WorshipPlayer.Presenter.Views.Settings.BiblesSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Section Title -->
            <TextBlock Text="Bibles" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Installed Translations -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Installed Translations" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>

                    <!-- Actions toolbar -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="ImportXmlButton" Content="Import XML"
                                Style="{StaticResource OwcAccentButton}"
                                FontSize="11" Padding="10,5" Margin="0,0,6,0"
                                Click="ImportXmlButton_Click"/>
                        <Button x:Name="SetDefaultButton" Content="Set Default"
                                Style="{StaticResource OwcButtonBase}"
                                FontSize="11" Padding="10,5" Margin="0,0,6,0"
                                Click="SetDefaultButton_Click"/>
                        <Button x:Name="RemoveButton" Content="Remove"
                                Style="{StaticResource OwcButtonBase}"
                                FontSize="11" Padding="10,5"
                                Click="RemoveButton_Click" IsEnabled="False"/>
                    </StackPanel>

                    <!-- List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="250">
                        <ListBox x:Name="TranslationListBox"
                                 Style="{StaticResource OwcServiceListBox}"
                                 SelectionChanged="TranslationList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                                           FontSize="13"/>
                                                <TextBlock Text="{Binding Abbreviation}"
                                                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Default"
                                                       Foreground="{StaticResource OwcAccentBrush}"
                                                       FontSize="10" VerticalAlignment="Center"
                                                       Visibility="{Binding DefaultVisibility}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Storage Info -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <TextBlock x:Name="StorageInfoText"
                           Text="2 translations installed"
                           Foreground="{StaticResource OwcTextSecondaryBrush}"
                           FontSize="11"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
