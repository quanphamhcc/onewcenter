<UserControl x:Class="WorshipPlayer.Presenter.Views.Settings.SlideLabelsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WorshipPlayer.Presenter.Views.Settings"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:HexBrushConverter x:Key="HexBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Section Title -->
            <TextBlock Text="Slide Labels" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="Labels tag the sections of a song (Verse, Chorus, Bridge…). The label name and color appear next to the section's slides in the Operator, and a label's hotkey jumps straight to that section while a song is live. Hotkeys are single letters; digits 1–9 stay reserved for jump-to-slide and B stays reserved for blackout. Two labels may not share a hotkey — saving is blocked while a duplicate exists."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource OwcTextSecondaryBrush}"
                       Margin="0,0,0,16"/>

            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <DataGrid x:Name="LabelsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserSortColumns="False"
                              SelectionMode="Single" HeadersVisibility="Column"
                              Background="{StaticResource OwcSurfaceBrush}"
                              Foreground="{StaticResource OwcTextPrimaryBrush}"
                              RowBackground="{StaticResource OwcSurfaceBrush}"
                              GridLinesVisibility="Horizontal"
                              BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1"
                              FontSize="12" RowHeight="30" MinHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTemplateColumn Header="Color" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="18" Height="18" CornerRadius="3" Margin="2,0,6,0"
                                                    BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1"
                                                    Background="{Binding Color, Converter={StaticResource HexBrushConverter}}"/>
                                            <TextBlock Text="{Binding Color}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Hotkey" Width="90"
                                                Binding="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="AddButton" Content="Add Label"
                                Style="{StaticResource OwcButtonBase}"
                                Padding="12,6" Margin="0,0,8,0"
                                Click="AddButton_Click"/>
                        <Button x:Name="DeleteButton" Content="Delete Selected"
                                Style="{StaticResource OwcButtonBase}"
                                Padding="12,6"
                                Click="DeleteButton_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="DuplicateWarningText" Text="" FontSize="11"
                               Foreground="OrangeRed" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <TextBlock Text="Deleting a label that sections still use is safe: those sections simply show no label until they are assigned another one. Changes apply when you press Save Settings."
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{StaticResource OwcTextSecondaryBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
