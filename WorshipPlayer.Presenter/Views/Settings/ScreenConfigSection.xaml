<UserControl x:Class="WorshipPlayer.Presenter.Views.Settings.ScreenConfigSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Section Title -->
            <TextBlock Text="Screen Configuration" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Audience Display Selection -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="AUDIENCE / CONGREGATION OUTPUT"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#F5A623" Margin="0,0,0,4"/>
                    <TextBlock Text="Select the monitor for lyrics projection:"
                               FontSize="12" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="AudienceMonitorCombo" Margin="0,0,0,0"
                              SelectionChanged="AudienceMonitor_Changed"/>
                </StackPanel>
            </Border>

            <!-- Stage Display Selection -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="STAGE / BACKSTAGE DISPLAY"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#00E676" Margin="0,0,0,4"/>
                    <TextBlock Text="Select the monitor for musician confidence display:"
                               FontSize="12" Foreground="{StaticResource OwcTextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    <ComboBox x:Name="StageMonitorCombo" Margin="0,0,0,0"
                              SelectionChanged="StageMonitor_Changed"/>
                    <TextBlock Text="Musicians can also use the web stage display on iPad/tablet at localhost:5055/stage"
                               FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Detected Monitors -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="DETECTED MONITORS"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource OwcTextMutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="RefreshButton" Content="Refresh"
                                Style="{StaticResource OwcButtonBase}"
                                FontSize="10" Padding="8,3" Margin="12,0,0,0"
                                Click="RefreshButton_Click"/>
                        <Button x:Name="IdentifyButton" Content="Show Monitor Numbers"
                                Style="{StaticResource OwcAccentButton}"
                                FontSize="10" Padding="8,3" Margin="12,0,0,0"
                                Click="IdentifyButton_Click"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="MonitorListText"
                                   FontSize="12"
                                   Foreground="{StaticResource OwcTextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- GPU Acceleration -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <CheckBox x:Name="GpuAccelerationToggle" Content="GPU Hardware Acceleration"
                              IsChecked="True"/>
                    <TextBlock Text="Application must restart for this change to take effect."
                               FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Info -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12">
                <TextBlock Text="Select which monitor is used for each purpose. The Audience output shows lyrics to the congregation. The Stage output shows chords and section info to musicians. Use 'None' to disable an output."
                           FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                           TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
