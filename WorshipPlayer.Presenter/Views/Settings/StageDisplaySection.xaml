<UserControl x:Class="WorshipPlayer.Presenter.Views.Settings.StageDisplaySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Section Title -->
            <TextBlock Text="Stage Display Layout" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Aspect Ratio / Foreground -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Aspect Ratio" FontSize="11"
                                   Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="AspectRatioComboBox"
                                  Background="{StaticResource OwcSurfaceBrush}"
                                  Foreground="{StaticResource OwcTextPrimaryBrush}"
                                  FontSize="12" Padding="8,6">
                            <ComboBoxItem Content="16:9" IsSelected="True"/>
                            <ComboBoxItem Content="4:3"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Foreground Content" FontSize="11"
                                   Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ForegroundComboBox"
                                  Background="{StaticResource OwcSurfaceBrush}"
                                  Foreground="{StaticResource OwcTextPrimaryBrush}"
                                  FontSize="12" Padding="8,6">
                            <ComboBoxItem Content="Current Slide" IsSelected="True"/>
                            <ComboBoxItem Content="Next Slide"/>
                            <ComboBoxItem Content="Clock"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Visual Layout Canvas -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Layout Editor" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Border Background="#000000" CornerRadius="4" Height="280">
                        <Canvas x:Name="LayoutCanvas" ClipToBounds="True">
                            <!-- Current Lyrics block -->
                            <Border Canvas.Left="20" Canvas.Top="20"
                                    Width="300" Height="150"
                                    Background="#1A3A5C" CornerRadius="4"
                                    BorderBrush="{StaticResource OwcAccentBrush}" BorderThickness="1">
                                <TextBlock Text="Current Lyrics"
                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Next Slide block -->
                            <Border Canvas.Left="340" Canvas.Top="20"
                                    Width="200" Height="100"
                                    Background="#2A1A3C" CornerRadius="4"
                                    BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1">
                                <TextBlock Text="Next Slide"
                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Clock block -->
                            <Border Canvas.Left="340" Canvas.Top="140"
                                    Width="200" Height="50"
                                    Background="#1A2A1C" CornerRadius="4"
                                    BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1">
                                <TextBlock Text="Clock"
                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <!-- Chords block -->
                            <Border Canvas.Left="20" Canvas.Top="190"
                                    Width="300" Height="70"
                                    Background="#3A2A1A" CornerRadius="4"
                                    BorderBrush="{StaticResource OwcBorderBrush}" BorderThickness="1">
                                <TextBlock Text="Chords"
                                           Foreground="{StaticResource OwcTextPrimaryBrush}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Canvas>
                    </Border>
                    <TextBlock Text="Drag blocks to rearrange the stage display layout."
                               FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
