<UserControl x:Class="WorshipPlayer.Presenter.Views.Settings.LibrarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/WorshipPlayer.Presenter;component/Themes/OwcDesignSystem.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <!-- Section Title -->
            <TextBlock Text="Library &amp; Database" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- Media Library Path -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Media Library Path" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LibraryPathTextBox" Grid.Column="0"
                                 Background="{StaticResource OwcSurfaceBrush}"
                                 Foreground="{StaticResource OwcTextPrimaryBrush}"
                                 BorderBrush="{StaticResource OwcBorderBrush}"
                                 FontSize="12" Padding="8,6" IsReadOnly="True"/>
                        <Button Grid.Column="1" x:Name="BrowseButton" Content="Browse"
                                Style="{StaticResource OwcButtonBase}"
                                FontSize="11" Padding="10,6" Margin="8,0,0,0"
                                Click="BrowseButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Storage Info -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Storage Information" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="File Count" FontSize="10"
                                       Foreground="{StaticResource OwcTextMutedBrush}"/>
                            <TextBlock x:Name="FileCountText" Text="0 files"
                                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Total Size" FontSize="10"
                                       Foreground="{StaticResource OwcTextMutedBrush}"/>
                            <TextBlock x:Name="TotalSizeText" Text="0 MB"
                                       Foreground="{StaticResource OwcTextPrimaryBrush}"
                                       FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Reset Library -->
            <Border Style="{StaticResource OwcSurfaceBorder}" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Library Reset" FontSize="11"
                               Foreground="{StaticResource OwcTextSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="This will remove all media references from the library database. Media files on disk will not be deleted."
                               FontSize="11" Foreground="{StaticResource OwcTextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Button x:Name="ResetLibraryButton" Content="Reset Library"
                            Style="{StaticResource OwcButtonBase}"
                            FontSize="11" Padding="10,6"
                            Click="ResetLibraryButton_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
