<Window x:Class="WorshipPlayer.Presenter.Views.DisplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display Settings"
        Height="500" Width="500"
        Background="#1E1E2E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Style ComboBox dropdown items for dark theme readability -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2D2D44" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252536" />
            <Setter Property="Foreground" Value="#F0F2F5" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#00D4FF" />
                    <Setter Property="Foreground" Value="#0F1117" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A3A4A" />
                    <Setter Property="Foreground" Value="#00D4FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Audience/Congregation Output -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="AUDIENCE / CONGREGATION OUTPUT"
                       FontSize="12" FontWeight="Bold"
                       Foreground="#F5A623" Margin="0,0,0,8" />
            <TextBlock Text="Select the monitor/projector for lyrics display:"
                       FontSize="12" Foreground="#AAAACC" Margin="0,0,0,6" />
            <ComboBox x:Name="AudienceDisplayCombo"
                      Background="#2D2D44" Foreground="#FFFFFF"
                      FontSize="14" Padding="8,6"
                      SelectionChanged="AudienceDisplayCombo_Changed" />
        </StackPanel>

        <!-- Stage Display -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="STAGE / BACKSTAGE DISPLAY"
                       FontSize="12" FontWeight="Bold"
                       Foreground="#4CAF50" Margin="0,0,0,8" />
            <TextBlock Text="Select the monitor for musician confidence display:"
                       FontSize="12" Foreground="#AAAACC" Margin="0,0,0,6" />
            <ComboBox x:Name="StageDisplayCombo"
                      Background="#2D2D44" Foreground="#FFFFFF"
                      FontSize="14" Padding="8,6"
                      SelectionChanged="StageDisplayCombo_Changed" />
            <TextBlock Text="(Musicians can also use the web stage display on iPad/tablet)"
                       FontSize="11" Foreground="#6C6C80" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Info -->
        <Border Grid.Row="4" Background="#252536" CornerRadius="4" Padding="12,8"
                MaxHeight="120">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="DETECTED MONITORS:" FontSize="11" FontWeight="Bold"
                               Foreground="#6C6C80" Margin="0,0,0,6" />
                    <TextBlock x:Name="MonitorListText"
                               FontSize="11" Foreground="#AAAACC"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons (always visible at bottom) -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,12,0,0">
            <Button Content="Refresh Monitors" Padding="16,8" Margin="0,0,12,0"
                    Background="#2D2D44" Foreground="#FFFFFF" BorderThickness="0"
                    Click="Refresh_Click" />
            <Button Content="Save &amp; Close" Padding="16,8"
                    Background="#4A90D9" Foreground="#FFFFFF"
                    FontWeight="Bold" BorderThickness="0"
                    Click="SaveClose_Click" />
        </StackPanel>
    </Grid>
</Window>
