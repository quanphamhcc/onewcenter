<UserControl x:Class="WorshipPlayer.Presenter.Controls.SlidePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="140" Height="85">

    <Border x:Name="PreviewBorder"
            Background="#1A1A2E"
            CornerRadius="4"
            BorderThickness="2"
            BorderBrush="Transparent"
            Padding="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Section Label -->
            <TextBlock x:Name="SectionLabelText"
                       Grid.Row="0"
                       FontSize="8"
                       Foreground="#888899"
                       HorizontalAlignment="Left"
                       Margin="2,0,0,2"
                       TextTrimming="CharacterEllipsis" />

            <!-- Slide Text Preview -->
            <Viewbox Grid.Row="1" Stretch="Uniform"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
                <TextBlock x:Name="SlideTextBlock"
                           FontSize="11"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="130"
                           TextTrimming="CharacterEllipsis" />
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
