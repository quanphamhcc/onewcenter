<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NOTE: No global implicit Button style. Using Cursor=Hand only on OwcButtonBase
         and inline on individual buttons. A global implicit Button style caused
         DependencyProperty.UnsetValue crash for BorderBrush when interfering with
         ControlTemplate TemplateBindings in derived styles. -->

    <!-- NOTE: No global implicit styles. ALL styles are keyed (x:Key) to prevent
         them from overriding WPF default ControlTemplates which causes
         DependencyProperty.UnsetValue errors and StackOverflow.
         
         Previous implicit styles for TextBox, ComboBox, CheckBox, ComboBoxItem
         caused infinite layout recursion by overriding WPF's built-in templates
         without providing replacement ControlTemplates. -->

    <!-- Colors and brushes are declared FIRST so every {StaticResource ...Brush}
         reference below resolves to a concrete value. StaticResource is resolved
         in document order within a dictionary; a forward reference (resource used
         above where it is defined) resolves to DependencyProperty.UnsetValue, which
         crashes any ControlTemplate that feeds it through a TemplateBinding
         (e.g. BorderBrush -> "'(DependencyProperty.UnsetValue)' is not a valid
         value for property 'BorderBrush'"). -->

    <!-- OWC Design Identity - Color Palette -->
    <Color x:Key="OwcBackgroundColor">#0F1117</Color>
    <Color x:Key="OwcPanelColor">#1A1D27</Color>
    <Color x:Key="OwcSurfaceColor">#252A36</Color>
    <Color x:Key="OwcAccentColor">#00D4FF</Color>
    <Color x:Key="OwcLiveColor">#FF3366</Color>
    <Color x:Key="OwcConnectedColor">#00E676</Color>
    <Color x:Key="OwcWarningColor">#FFAB00</Color>
    <Color x:Key="OwcTextPrimaryColor">#F0F2F5</Color>
    <Color x:Key="OwcTextSecondaryColor">#8B92A5</Color>
    <Color x:Key="OwcTextMutedColor">#4A5068</Color>
    <Color x:Key="OwcBorderColor">#2A2E3A</Color>

    <!-- Hover/Interaction Colors -->
    <Color x:Key="OwcSurfaceHoverColor">#2F3544</Color>

    <!-- Blue primary-action accent (distinct from the cyan OwcAccent used for the
         nav/active-tab). Added for the Home "+ Add a new service" primary button to match
         the reference design's blue CTA. -->
    <Color x:Key="OwcBlueColor">#2F6FED</Color>
    <Color x:Key="OwcBlueHoverColor">#2B63D4</Color>

    <!-- Brush Resources -->
    <SolidColorBrush x:Key="OwcBackgroundBrush" Color="{StaticResource OwcBackgroundColor}" />
    <SolidColorBrush x:Key="OwcPanelBrush" Color="{StaticResource OwcPanelColor}" />
    <SolidColorBrush x:Key="OwcSurfaceBrush" Color="{StaticResource OwcSurfaceColor}" />
    <SolidColorBrush x:Key="OwcSurfaceHoverBrush" Color="{StaticResource OwcSurfaceHoverColor}" />
    <SolidColorBrush x:Key="OwcAccentBrush" Color="{StaticResource OwcAccentColor}" />
    <SolidColorBrush x:Key="OwcLiveBrush" Color="{StaticResource OwcLiveColor}" />
    <SolidColorBrush x:Key="OwcConnectedBrush" Color="{StaticResource OwcConnectedColor}" />
    <SolidColorBrush x:Key="OwcWarningBrush" Color="{StaticResource OwcWarningColor}" />
    <SolidColorBrush x:Key="OwcTextPrimaryBrush" Color="{StaticResource OwcTextPrimaryColor}" />
    <SolidColorBrush x:Key="OwcTextSecondaryBrush" Color="{StaticResource OwcTextSecondaryColor}" />
    <SolidColorBrush x:Key="OwcTextMutedBrush" Color="{StaticResource OwcTextMutedColor}" />
    <SolidColorBrush x:Key="OwcBorderBrush" Color="{StaticResource OwcBorderColor}" />
    <SolidColorBrush x:Key="OwcBlueBrush" Color="{StaticResource OwcBlueColor}" />
    <SolidColorBrush x:Key="OwcBlueHoverBrush" Color="{StaticResource OwcBlueHoverColor}" />

    <!-- Keyed styles - must be explicitly applied via Style="{StaticResource ...}" -->
    <Style x:Key="OwcTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Dark ComboBoxItem (used inside the dark ComboBox dropdown Popup).
         Full ControlTemplate so the item renders dark instead of the WPF default white. -->
    <Style x:Key="OwcDarkComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource OwcPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background"
                                    Value="{StaticResource OwcAccentBrush}" />
                            <Setter Property="Foreground">
                                <Setter.Value>
                                    <SolidColorBrush Color="#0F1117" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#1A3A4A" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource OwcAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton used by the dark ComboBox template -->
    <Style x:Key="OwcComboBoxToggleButton" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <Path x:Name="Arrow"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Data="M 0 0 L 4 4 L 8 0 Z"
                              Fill="{StaticResource OwcTextPrimaryBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark ComboBox: full ControlTemplate so BOTH the closed face and the opened
         dropdown Popup render dark (OwcSurface/OwcPanel) with light text.
         The default WPF template renders white/light, making OwcTextPrimary text
         invisible. Keyed — apply explicitly via Style="{StaticResource OwcDarkComboBox}". -->
    <Style x:Key="OwcDarkComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource OwcDarkComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="MainBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" />
                        <ContentPresenter x:Name="ContentSite"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          IsHitTestVisible="False" />
                        <ToggleButton Grid.Column="0"
                                      Style="{StaticResource OwcComboBoxToggleButton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource OwcPanelBrush}"
                                    BorderBrush="{StaticResource OwcBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,2,0,0">
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background"
                                    Value="{StaticResource OwcSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource OwcTextMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Back-compat alias: existing callers reference OwcComboBox. Kept as the
         original lightweight keyed style (NO ControlTemplate) so existing
         ComboBoxes behave exactly as before and do not get the heavy dark
         template forced onto them. Apply OwcDarkComboBox explicitly where a
         dark dropdown is wanted (e.g. the Songs-tab filters). -->
    <Style x:Key="OwcComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="OwcCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Button Base Style -->
    <Style x:Key="OwcButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource OwcSurfaceHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Nav-tab Button (top-nav pill). Transparent surface, secondary text, medium weight.
         Keyed — apply explicitly. Active state is driven in code-behind by setting Foreground
         (cyan) and the bottom BorderBrush, so this style only provides the resting/hover look. -->
    <Style x:Key="OwcNavTabButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextSecondaryBrush}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Compact Button (sidebar/toolbar actions). Small surface chip, light text,
         rounded via OwcButtonBase template. Keyed — apply explicitly. -->
    <Style x:Key="OwcCompactButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Accent Button Style (Primary action) -->
    <Style x:Key="OwcAccentButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="Background" Value="{StaticResource OwcAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Blue Button Style (Primary CTA used on the Home screen "+ Add a new service").
         Overrides OwcButtonBase's surface-hover trigger so it stays blue on hover. -->
    <Style x:Key="OwcBlueButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="Background" Value="{StaticResource OwcBlueBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource OwcBlueHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Live Button Style -->
    <Style x:Key="OwcLiveButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="Background" Value="{StaticResource OwcLiveBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Panel Style -->
    <Style x:Key="OwcPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OwcPanelBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Surface Panel Style -->
    <Style x:Key="OwcSurfaceBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ListBox Style for Service Order -->
    <Style x:Key="OwcServiceListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Slider Style -->
    <Style x:Key="OwcSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource OwcAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
    </Style>

    <!-- ComboBox Item Style (keyed — apply explicitly) -->
    <Style x:Key="OwcComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource OwcPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource OwcAccentBrush}" />
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="#0F1117" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#1A3A4A" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{StaticResource OwcAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Transport Button (Large) -->
    <Style x:Key="OwcTransportButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinWidth" Value="70" />
    </Style>

    <!-- Transport Button Dark -->
    <Style x:Key="OwcTransportButtonDark" TargetType="Button" BasedOn="{StaticResource OwcTransportButton}">
        <Setter Property="Background" Value="{StaticResource OwcPanelBrush}" />
    </Style>

    <!-- Dark GridViewColumnHeader for the services tables. Keyed — apply explicitly.
         Dark header row with secondary text and a thin bottom border. -->
    <Style x:Key="OwcDarkGridViewColumnHeader" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource OwcPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource OwcBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark ListViewItem for the services tables: a full ControlTemplate so rows render dark
         and highlight on hover/selection via OwcSurfaceHoverBrush (the default WPF item chrome
         would paint a light highlight). Keyed; referenced by OwcDarkListView below. -->
    <Style x:Key="OwcDarkListViewItem" TargetType="ListViewItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="RowBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource OwcBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Columns="{TemplateBinding GridView.ColumnCollection}"
                                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background"
                                    Value="{StaticResource OwcSurfaceHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background"
                                    Value="{StaticResource OwcSurfaceHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark ListView for the services tables. Transparent/dark background, light foreground,
         no default border, and the dark item container style above. Keyed — apply explicitly. -->
    <Style x:Key="OwcDarkListView" TargetType="ListView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource OwcDarkListViewItem}" />
    </Style>

</ResourceDictionary>
