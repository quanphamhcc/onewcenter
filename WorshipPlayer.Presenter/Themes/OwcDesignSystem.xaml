<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- NOTE: No global implicit Button style. Using Cursor=Hand only on OwcButtonBase
         and inline on individual buttons. A global implicit Button style caused
         DependencyProperty.UnsetValue crash for BorderBrush when interfering with
         ControlTemplate TemplateBindings in derived styles. -->

    <!-- NOTE: No global implicit styles. ALL styles are keyed (x:Key) to prevent
         them from overriding WPF default ControlTemplates which causes
         DependencyProperty.UnsetValue errors and StackOverflow.
         
         Previous implicit styles for TextBox, ComboBox, CheckBox, ComboBoxItem
         caused infinite layout recursion by overriding WPF's built-in templates
         without providing replacement ControlTemplates. -->

    <!-- Keyed styles - must be explicitly applied via Style="{StaticResource ...}" -->
    <Style x:Key="OwcTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="OwcComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="OwcCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- OWC Design Identity - Color Palette -->
    <Color x:Key="OwcBackgroundColor">#0F1117</Color>
    <Color x:Key="OwcPanelColor">#1A1D27</Color>
    <Color x:Key="OwcSurfaceColor">#252A36</Color>
    <Color x:Key="OwcAccentColor">#00D4FF</Color>
    <Color x:Key="OwcLiveColor">#FF3366</Color>
    <Color x:Key="OwcConnectedColor">#00E676</Color>
    <Color x:Key="OwcWarningColor">#FFAB00</Color>
    <Color x:Key="OwcTextPrimaryColor">#F0F2F5</Color>
    <Color x:Key="OwcTextSecondaryColor">#8B92A5</Color>
    <Color x:Key="OwcTextMutedColor">#4A5068</Color>
    <Color x:Key="OwcBorderColor">#2A2E3A</Color>

    <!-- Hover/Interaction Colors -->
    <Color x:Key="OwcSurfaceHoverColor">#2F3544</Color>

    <!-- Brush Resources -->
    <SolidColorBrush x:Key="OwcBackgroundBrush" Color="{StaticResource OwcBackgroundColor}" />
    <SolidColorBrush x:Key="OwcPanelBrush" Color="{StaticResource OwcPanelColor}" />
    <SolidColorBrush x:Key="OwcSurfaceBrush" Color="{StaticResource OwcSurfaceColor}" />
    <SolidColorBrush x:Key="OwcSurfaceHoverBrush" Color="{StaticResource OwcSurfaceHoverColor}" />
    <SolidColorBrush x:Key="OwcAccentBrush" Color="{StaticResource OwcAccentColor}" />
    <SolidColorBrush x:Key="OwcLiveBrush" Color="{StaticResource OwcLiveColor}" />
    <SolidColorBrush x:Key="OwcConnectedBrush" Color="{StaticResource OwcConnectedColor}" />
    <SolidColorBrush x:Key="OwcWarningBrush" Color="{StaticResource OwcWarningColor}" />
    <SolidColorBrush x:Key="OwcTextPrimaryBrush" Color="{StaticResource OwcTextPrimaryColor}" />
    <SolidColorBrush x:Key="OwcTextSecondaryBrush" Color="{StaticResource OwcTextSecondaryColor}" />
    <SolidColorBrush x:Key="OwcTextMutedBrush" Color="{StaticResource OwcTextMutedColor}" />
    <SolidColorBrush x:Key="OwcBorderBrush" Color="{StaticResource OwcBorderColor}" />

    <!-- Button Base Style -->
    <Style x:Key="OwcButtonBase" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource OwcSurfaceHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Accent Button Style (Primary action) -->
    <Style x:Key="OwcAccentButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="Background" Value="{StaticResource OwcAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Live Button Style -->
    <Style x:Key="OwcLiveButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="Background" Value="{StaticResource OwcLiveBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!-- Panel Style -->
    <Style x:Key="OwcPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OwcPanelBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Surface Panel Style -->
    <Style x:Key="OwcSurfaceBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="{StaticResource OwcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ListBox Style for Service Order -->
    <Style x:Key="OwcServiceListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Slider Style -->
    <Style x:Key="OwcSlider" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource OwcAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource OwcSurfaceBrush}" />
    </Style>

    <!-- ComboBox Item Style (keyed — apply explicitly) -->
    <Style x:Key="OwcComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource OwcPanelBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OwcTextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource OwcAccentBrush}" />
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="#0F1117" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="#1A3A4A" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="{StaticResource OwcAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Transport Button (Large) -->
    <Style x:Key="OwcTransportButton" TargetType="Button" BasedOn="{StaticResource OwcButtonBase}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="MinWidth" Value="70" />
    </Style>

    <!-- Transport Button Dark -->
    <Style x:Key="OwcTransportButtonDark" TargetType="Button" BasedOn="{StaticResource OwcTransportButton}">
        <Setter Property="Background" Value="{StaticResource OwcPanelBrush}" />
    </Style>

</ResourceDictionary>
