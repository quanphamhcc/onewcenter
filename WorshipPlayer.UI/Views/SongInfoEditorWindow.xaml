<Window x:Class="WorshipPlayer.UI.Views.SongInfoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Song Info"
        Height="520" Width="500"
        Background="#1E1E2E"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Song Information" FontSize="20" FontWeight="Bold"
                   Foreground="White" Margin="0,0,0,16" />

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Title -->
                <TextBlock Text="Title" Foreground="#B0B0C0" FontSize="12" Margin="0,0,0,4" />
                <TextBox x:Name="TitleBox" Height="28" FontSize="13"
                         Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                         Padding="6,3" />

                <!-- Key -->
                <TextBlock Text="Key" Foreground="#B0B0C0" FontSize="12" Margin="0,12,0,4" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="KeyCombo" Width="80" Height="28" FontSize="13"
                              Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60">
                        <ComboBoxItem Content="C" />
                        <ComboBoxItem Content="C#" />
                        <ComboBoxItem Content="Db" />
                        <ComboBoxItem Content="D" />
                        <ComboBoxItem Content="Eb" />
                        <ComboBoxItem Content="E" />
                        <ComboBoxItem Content="F" />
                        <ComboBoxItem Content="F#" />
                        <ComboBoxItem Content="Gb" />
                        <ComboBoxItem Content="G" />
                        <ComboBoxItem Content="Ab" />
                        <ComboBoxItem Content="A" />
                        <ComboBoxItem Content="Bb" />
                        <ComboBoxItem Content="B" />
                    </ComboBox>
                    <ComboBox x:Name="KeyModeCombo" Width="80" Height="28" FontSize="13"
                              Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                              Margin="8,0,0,0">
                        <ComboBoxItem Content="Major" IsSelected="True" />
                        <ComboBoxItem Content="Minor" />
                    </ComboBox>
                </StackPanel>

                <!-- BPM -->
                <TextBlock Text="BPM" Foreground="#B0B0C0" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="BpmBox" Width="100" Height="28" FontSize="13"
                         Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                         Padding="6,3" HorizontalAlignment="Left" />

                <!-- Time Signature -->
                <TextBlock Text="Time Signature" Foreground="#B0B0C0" FontSize="12" Margin="0,12,0,4" />
                <ComboBox x:Name="TimeSigCombo" Width="80" Height="28" FontSize="13"
                          Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                          HorizontalAlignment="Left">
                    <ComboBoxItem Content="4/4" />
                    <ComboBoxItem Content="3/4" />
                    <ComboBoxItem Content="6/8" />
                </ComboBox>

                <!-- Composer -->
                <TextBlock Text="Composer" Foreground="#B0B0C0" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="ComposerBox" Height="28" FontSize="13"
                         Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                         Padding="6,3" />

                <!-- Lyricist -->
                <TextBlock Text="Lyricist" Foreground="#B0B0C0" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="LyricistBox" Height="28" FontSize="13"
                         Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                         Padding="6,3" />

                <!-- Arranger -->
                <TextBlock Text="Arranger" Foreground="#B0B0C0" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="ArrangerBox" Height="28" FontSize="13"
                         Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                         Padding="6,3" />

                <!-- Themes -->
                <TextBlock Text="Themes (comma-separated)" Foreground="#B0B0C0" FontSize="12" Margin="0,12,0,4" />
                <TextBox x:Name="ThemesBox" Height="28" FontSize="13"
                         Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                         Padding="6,3" />
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="SAVE" Click="Save_Click" Margin="4,0"
                    Style="{StaticResource TransportButton}"
                    Background="#7ED321" Foreground="Black" FontWeight="ExtraBold" MinWidth="80" />
            <Button Content="Cancel" Click="Cancel_Click" Margin="4,0"
                    Style="{StaticResource TransportButton}" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
