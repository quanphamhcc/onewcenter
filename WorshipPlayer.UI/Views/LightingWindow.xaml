<Window x:Class="WorshipPlayer.UI.Views.LightingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lighting Control - MaestroDMX / MIDI"
        Height="650" Width="950"
        Background="{StaticResource PrimaryDarkBrush}"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="LIGHTING CONTROL" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

        <!-- Connection Settings -->
        <Border Grid.Row="1" Background="{StaticResource SecondaryDarkBrush}"
                CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- OSC Settings -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="OSC (MaestroDMX)" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <CheckBox x:Name="OscEnabledCheck" Content="Enabled"
                                  Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Host: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Width="50" />
                        <TextBox x:Name="OscHostBox" Width="150" Text="192.168.1.100" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Port: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Width="50" />
                        <TextBox x:Name="OscPortBox" Width="80" Text="8000" />
                    </StackPanel>
                    <Button Content="Test Connection" Style="{StaticResource TransportButton}"
                            Click="TestOsc_Click" Margin="0,8,0,0" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- MIDI Settings -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="MIDI (Fallback)" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <CheckBox x:Name="MidiEnabledCheck" Content="Enabled"
                                  Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Device: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Width="50" />
                        <ComboBox x:Name="MidiDeviceCombo" Width="200" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Channel: " Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Width="50" />
                        <ComboBox x:Name="MidiChannelCombo" Width="60" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section Lighting Presets -->
        <DataGrid x:Name="PresetsGrid" Grid.Row="2"
                  AutoGenerateColumns="False"
                  Background="{StaticResource SecondaryDarkBrush}"
                  Foreground="{StaticResource TextPrimaryBrush}"
                  RowBackground="{StaticResource SecondaryDarkBrush}"
                  AlternatingRowBackground="{StaticResource SurfaceDarkBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource SurfaceDarkBrush}"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  FontSize="13">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Section" Width="140" IsReadOnly="True"
                                    Binding="{Binding SectionName}" />
                <DataGridTextColumn Header="Palette" Width="80"
                                    Binding="{Binding PaletteIndex}" />
                <DataGridTextColumn Header="Intensity %" Width="90"
                                    Binding="{Binding IntensityPercent}" />
                <DataGridTextColumn Header="Excitement %" Width="100"
                                    Binding="{Binding ExcitementPercent}" />
                <DataGridTextColumn Header="Snapshot" Width="120"
                                    Binding="{Binding SnapshotName}" />
                <DataGridTextColumn Header="MIDI Note" Width="80"
                                    Binding="{Binding MidiNote}" />
                <DataGridTextColumn Header="MIDI Vel" Width="80"
                                    Binding="{Binding MidiVelocity}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Manual Controls -->
        <Border Grid.Row="3" Background="{StaticResource SecondaryDarkBrush}"
                CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Manual Override: " FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <Button Content="BLACKOUT" Style="{StaticResource TransportButton}"
                        Click="Blackout_Click" Margin="8,0"
                        Background="{StaticResource AccentRedBrush}" />
                <Button Content="FLASH" Style="{StaticResource TransportButton}"
                        Click="Flash_Click" Margin="8,0" />
                <Button Content="FULL BRIGHT" Style="{StaticResource TransportButton}"
                        Click="FullBright_Click" Margin="8,0" />
            </StackPanel>
        </Border>

        <!-- Save/Close -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save Settings" Style="{StaticResource TransportButton}"
                    Click="Save_Click" Background="{StaticResource AccentGreenBrush}" Margin="4,0" />
            <Button Content="Close" Style="{StaticResource TransportButton}"
                    Click="Close_Click" Margin="4,0" />
        </StackPanel>
    </Grid>
</Window>
