<Window x:Class="WorshipPlayer.UI.Views.MidiCueEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MIDI Cue Editor — WorshipTools Presenter"
        Height="550" Width="900"
        Background="#1E1E2E"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" Text="MIDI Cue Editor"
                       FontSize="18" FontWeight="Bold" Foreground="White" />
            <TextBlock x:Name="SongInfoText" Text=""
                       FontSize="11" Foreground="#B0B0C0" Margin="0,2,0,0" />
            <TextBlock Text="Send MIDI cues to WorshipTools Presenter for automatic lyric advancement."
                       FontSize="10" Foreground="#808090" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Cue List DataGrid -->
        <DataGrid x:Name="CueGrid" Grid.Row="1"
                  AutoGenerateColumns="False"
                  Background="#2B2B3D"
                  Foreground="White"
                  RowBackground="#2B2B3D"
                  AlternatingRowBackground="#363650"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#4A4A60"
                  BorderThickness="1"
                  BorderBrush="#4A4A60"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  FontSize="12"
                  RowHeight="26"
                  HeadersVisibility="Column">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#4A90D9" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="6,4" />
                    <Setter Property="BorderBrush" Value="#3A7BC0" />
                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="3,1" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#4A90D9" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="On" Width="35"
                                        Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="#" Width="30" IsReadOnly="True"
                                    Binding="{Binding Index}" />
                <DataGridTextColumn Header="Time" Width="80"
                                    Binding="{Binding TimestampDisplay}" IsReadOnly="True" />
                <DataGridTextColumn Header="Action" Width="110"
                                    Binding="{Binding ActionDisplay}" />
                <DataGridTextColumn Header="Note" Width="45"
                                    Binding="{Binding Note}" />
                <DataGridTextColumn Header="Vel" Width="40"
                                    Binding="{Binding Velocity}" />
                <DataGridTextColumn Header="Ch" Width="35"
                                    Binding="{Binding Channel}" />
                <DataGridTextColumn Header="Slide #" Width="55"
                                    Binding="{Binding SlideNumber}" />
                <DataGridTextColumn Header="Label" Width="*"
                                    Binding="{Binding Label}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Record Mode & Add/Edit Controls -->
        <Border Grid.Row="2" BorderBrush="#4A4A60" BorderThickness="1"
                Background="#252538" Margin="0,8,0,0" Padding="10,8" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Record Mode -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="RecordBtn" Content="RECORD MODE"
                            Click="Record_Click" Margin="0,0,8,0"
                            Background="DarkRed" Foreground="White"
                            FontWeight="Bold" Padding="12,6"
                            ToolTip="Enable record mode: tap SPACE during playback to place 'Next Slide' cues at current position" />
                    <TextBlock x:Name="RecordStatusText" Text=""
                               FontSize="11" Foreground="OrangeRed"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Position -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="Position:" FontSize="11" Foreground="#B0B0C0"
                               VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="TimestampBox" Width="90" Height="24"
                             FontSize="11" Background="#2B2B3D" Foreground="White"
                             BorderBrush="#4A4A60" VerticalContentAlignment="Center"
                             Padding="4,0" ToolTip="Enter timestamp (M:SS:MMM or milliseconds)" />
                    <ComboBox x:Name="ActionComboBox" Width="100" Height="24"
                              FontSize="11" Margin="4,0" Background="#2B2B3D"
                              Foreground="White" BorderBrush="#4A4A60" SelectedIndex="0">
                        <ComboBoxItem Content="Next Slide" />
                        <ComboBoxItem Content="Prev Slide" />
                        <ComboBoxItem Content="Next Item" />
                        <ComboBoxItem Content="Trigger Slide" />
                    </ComboBox>
                    <Button Content="+ Add Cue" Click="AddCue_Click" Margin="4,0"
                            Background="#50E3C2" Foreground="Black" FontWeight="Bold"
                            Padding="8,4" />
                </StackPanel>

                <!-- Right: Management -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Delete" Click="DeleteCue_Click" Margin="4,0"
                            Padding="8,4" />
                    <Button Content="Clear All" Click="ClearAll_Click" Margin="4,0"
                            Padding="8,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="Test Send" Click="TestSend_Click" Margin="4,0"
                    Padding="10,6" ToolTip="Send a test MIDI Note On to verify connection" />
            <Button Content="SAVE" Click="Save_Click" Margin="4,0"
                    Background="#7ED321" Foreground="Black" FontWeight="ExtraBold"
                    Padding="16,6" />
            <Button Content="Cancel" Click="Cancel_Click" Margin="4,0"
                    Padding="10,6" />
        </StackPanel>
    </Grid>
</Window>
