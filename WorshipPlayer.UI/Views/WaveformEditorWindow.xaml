<Window x:Class="WorshipPlayer.UI.Views.WaveformEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waveform Editor"
        Height="600" Width="1200"
        Background="#0D0D1A"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="SectionTitle" Text="Section: VERSE 1"
                       FontSize="18" FontWeight="Bold" Foreground="White" />
            <TextBlock x:Name="SectionInfo" Text=""
                       FontSize="12" Foreground="#B0B0C0" Margin="0,4,0,0" />
            <TextBlock x:Name="WaveformLoadingText" Text="Loading waveforms..."
                       FontSize="13" FontWeight="SemiBold" Foreground="#50E3C2"
                       Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>

        <!-- Click Track Waveform -->
        <Border Grid.Row="1" Background="#1A1A2E" BorderBrush="#4A4A60"
                BorderThickness="1" Margin="0,0,0,4" CornerRadius="4">
            <Grid>
                <Canvas x:Name="ClickWaveformCanvas" ClipToBounds="True"
                        MouseMove="WaveformCanvas_MouseMove"
                        MouseLeftButtonDown="WaveformCanvas_MarkerMouseDown"
                        MouseLeftButtonUp="WaveformCanvas_MarkerMouseUp"
                        MouseWheel="WaveformCanvas_MouseWheel" />
                <TextBlock Text="Click Track" FontSize="10" Foreground="#6C6C80"
                           Margin="8,4" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <!-- Full Mix Waveform -->
        <Border Grid.Row="2" Background="#1A1A2E" BorderBrush="#4A4A60"
                BorderThickness="1" Margin="0,4,0,0" CornerRadius="4">
            <Grid>
                <Canvas x:Name="MixWaveformCanvas" ClipToBounds="True"
                        MouseMove="WaveformCanvas_MouseMove"
                        MouseLeftButtonDown="WaveformCanvas_MarkerMouseDown"
                        MouseLeftButtonUp="WaveformCanvas_MarkerMouseUp"
                        MouseWheel="WaveformCanvas_MouseWheel" />
                <TextBlock Text="Full Mix" FontSize="10" Foreground="#6C6C80"
                           Margin="8,4" VerticalAlignment="Top" />
                <!-- Drag tooltip -->
                <Border x:Name="DragTooltip" Background="#333350" CornerRadius="4"
                        Padding="6,3" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="DragTooltipText" Text="" FontSize="11"
                               Foreground="White" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <!-- Loop Point Info -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,8">
            <TextBlock Text="Loop IN: " Foreground="#B0B0C0" FontSize="13" VerticalAlignment="Center" />
            <TextBlock x:Name="LoopInText" Text="0:00:000" Foreground="#7ED321"
                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="    Loop OUT: " Foreground="#B0B0C0" FontSize="13"
                       VerticalAlignment="Center" Margin="20,0,0,0" />
            <TextBlock x:Name="LoopOutText" Text="0:00:000" Foreground="#E74C3C"
                       FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="    Duration: " Foreground="#B0B0C0" FontSize="13"
                       VerticalAlignment="Center" Margin="20,0,0,0" />
            <TextBlock x:Name="DurationText" Text="" Foreground="White"
                       FontSize="13" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Collapsible Lyrics & Chords Panel -->
        <Expander Grid.Row="4" Header="Lyrics &amp; Chords" Foreground="#B0B0C0" FontSize="12"
                  Margin="0,0,0,8" IsExpanded="False">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ToggleButton x:Name="ShowChordsToggle" Content="Show Chords"
                                  IsChecked="True" Click="ShowChordsToggle_Click"
                                  Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                  ToolTip="Toggle chord display [B] [E] on/off" />
                    <TextBlock x:Name="ChordFormatHint" Text="Inline format: [B]lyrics [E]here"
                               FontSize="9" Foreground="#808090" VerticalAlignment="Center" />
                    <TextBlock Text="   Lines/slide:" FontSize="10" Foreground="#B0B0C0"
                               VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox x:Name="SectionLinesPerSlideCombo" Width="90" Height="22" FontSize="10"
                              Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                              SelectionChanged="SectionLinesPerSlide_Changed"
                              ToolTip="Lines per slide for THIS section (Global = use the Presenter default)">
                        <ComboBoxItem Content="Global" Tag="" Foreground="Black" IsSelected="True" />
                        <ComboBoxItem Content="2 lines" Tag="2" Foreground="Black" />
                        <ComboBoxItem Content="3 lines" Tag="3" Foreground="Black" />
                        <ComboBoxItem Content="4 lines" Tag="4" Foreground="Black" />
                    </ComboBox>
                </StackPanel>
                <TextBox x:Name="LyricsTextBox" AcceptsReturn="True" TextWrapping="NoWrap"
                         MinHeight="80" MaxHeight="250"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontSize="13" FontFamily="Consolas, Courier New, monospace"
                         Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                         Padding="8,6"
                         ToolTip="Lyrics with inline chords: [B]The Lord [E]bless you&#10;Empty line = slide break&#10;[N.C.] = no chord" />
            </StackPanel>
        </Expander>

        <!-- Sub-sections list (shown after granular detect) -->
        <ListBox x:Name="SubSectionsList" Grid.Row="5" Visibility="Collapsed"
                 Background="#1A1A2E" Foreground="White" BorderBrush="#4A4A60"
                 MaxHeight="120" Margin="0,0,0,8"
                 SelectionMode="Extended"
                 MouseDoubleClick="SubSectionsList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,1">
                        <Button Content="▶" Width="24" Height="22" FontSize="10"
                                Click="SubSectionPlay_Click" Tag="{Binding}"
                                Background="#0E7E7E" Foreground="White" BorderThickness="0"
                                ToolTip="Loop this sub-section" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Display}" FontSize="12"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Interactive Review Panel (shown during granular review) -->
        <Border x:Name="ReviewPanel" Grid.Row="5" Visibility="Collapsed"
                Background="#1A1A2E" BorderBrush="#4A90D9" BorderThickness="1"
                CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="ReviewTitle" Text="Reviewing: CHORUS (a) [1 of 4]"
                           FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,6" />
                <TextBlock x:Name="ReviewScore" Text="Score: 92% ✓ Beat ✓ Energy ✓ Lyrics"
                           FontSize="12" Foreground="#7ED321" Margin="0,0,0,8" />
                <!-- Nudge controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="IN: " Foreground="#7ED321" FontSize="12" VerticalAlignment="Center" />
                    <Button Content="◀◀" Click="NudgeInBack2_Click" Width="30" Height="24"
                            Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="2,0" />
                    <Button Content="◀" Click="NudgeInBack_Click" Width="30" Height="24"
                            Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="2,0" />
                    <TextBlock x:Name="ReviewInText" Text="1:19:722" FontSize="12"
                               Foreground="#7ED321" VerticalAlignment="Center" Margin="6,0" FontWeight="Bold" />
                    <Button Content="▶" Click="NudgeInFwd_Click" Width="30" Height="24"
                            Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="2,0" />
                    <Button Content="▶▶" Click="NudgeInFwd2_Click" Width="30" Height="24"
                            Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="2,0" />
                    <TextBlock Text="    OUT: " Foreground="#E74C3C" FontSize="12" VerticalAlignment="Center" />
                    <Button Content="◀◀" Click="NudgeOutBack2_Click" Width="30" Height="24"
                            Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="2,0" />
                    <Button Content="◀" Click="NudgeOutBack_Click" Width="30" Height="24"
                            Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="2,0" />
                    <TextBlock x:Name="ReviewOutText" Text="1:33:437" FontSize="12"
                               Foreground="#E74C3C" VerticalAlignment="Center" Margin="6,0" FontWeight="Bold" />
                    <Button Content="▶" Click="NudgeOutFwd_Click" Width="30" Height="24"
                            Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="2,0" />
                    <Button Content="▶▶" Click="NudgeOutFwd2_Click" Width="30" Height="24"
                            Background="#2B2B3D" Foreground="White" BorderThickness="0" Margin="2,0" />
                </StackPanel>
                <!-- Nudge amount + action buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Nudge: " Foreground="#B0B0C0" FontSize="12" VerticalAlignment="Center" />
                    <ComboBox x:Name="NudgeAmountCombo" Width="80" Height="24" FontSize="11"
                              Background="#2B2B3D" Foreground="White" BorderBrush="#4A4A60"
                              SelectedIndex="1">
                        <ComboBoxItem Content="1 bar" />
                        <ComboBoxItem Content="1 beat" />
                        <ComboBoxItem Content="1/16" />
                        <ComboBoxItem Content="1/32" />
                    </ComboBox>
                    <Button Content="APPROVE" Click="ReviewApprove_Click" Margin="16,0,4,0"
                            Background="#7ED321" Foreground="Black" FontWeight="Bold"
                            Style="{StaticResource TransportButton}" />
                    <Button Content="SKIP" Click="ReviewSkip_Click" Margin="4,0"
                            Background="#F5A623" Foreground="Black" FontWeight="Bold"
                            Style="{StaticResource TransportButton}" />
                    <Button Content="Save All" Click="ReviewSaveAll_Click" Margin="4,0"
                            Background="#4A90D9" Foreground="White" FontWeight="Bold"
                            Style="{StaticResource TransportButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Margin="0,4,0,0">
            <!-- Row 0: Navigation -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Button Content="◀◀" Click="ScrollFarLeft_Click"
                        Style="{StaticResource TransportButton}" Margin="2,0" Width="36"
                        ToolTip="Scroll to start" />
                <Button Content="◀" Click="ScrollLeft_Click"
                        Style="{StaticResource TransportButton}" Margin="2,0" Width="36"
                        ToolTip="Scroll left" />
                <Button Content="Go to IN" Click="GoToLoopIn_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        Foreground="#7ED321" ToolTip="Center view on Loop IN marker" />
                <Button Content="Go to OUT" Click="GoToLoopOut_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        Foreground="#E74C3C" ToolTip="Center view on Loop OUT marker" />
                <Button Content="▶" Click="ScrollRight_Click"
                        Style="{StaticResource TransportButton}" Margin="2,0" Width="36"
                        ToolTip="Scroll right" />
                <Button Content="▶▶" Click="ScrollFarRight_Click"
                        Style="{StaticResource TransportButton}" Margin="2,0" Width="36"
                        ToolTip="Scroll to end" />
            </StackPanel>
            <!-- Row 1: Transport + Detection -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Button x:Name="PlayBtn" Content="PLAY" Click="Play_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        Background="DarkGreen" MinWidth="70"
                        ToolTip="Play from Loop IN point" />
                <Button x:Name="PlayLoopBtn" Content="PLAY LOOP" Click="PlayLoop_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        Background="DarkCyan" MinWidth="90"
                        ToolTip="Continuously loop between IN and OUT markers (real-time preview)" />
                <Button Content="Stop" Click="Stop_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        ToolTip="Stop playback" />
                <Button Content="Preview Chart" Click="PreviewChordChart_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        Background="#9B59B6" Foreground="White"
                        ToolTip="Open chord chart preview and start playing — validates slide timing visually" />
                <TextBlock Text="  |  " Foreground="#4A4A60" VerticalAlignment="Center" />
                <Button Content="Auto-Detect (Granular)" Click="GranularDetect_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        Background="DarkSlateBlue"
                        ToolTip="Find precise loop points and split into sub-sections" />
                <Button Content="Merge Selected" Click="MergeSelected_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        ToolTip="Merge selected sub-sections (Ctrl+click to multi-select)" />
            </StackPanel>
            <!-- Row 2: Snap + Save -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Snap to Beat" Click="SnapToBeat_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        ToolTip="Snap loop points to nearest beat" />
                <Button Content="Snap to Bar" Click="SnapToBar_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        ToolTip="Snap loop points to nearest bar downbeat" />
                <TextBlock Text=" | " Foreground="#4A4A60" VerticalAlignment="Center" />
                <TextBlock Text="Grid:" FontSize="10" Foreground="#B0B0C0"
                           VerticalAlignment="Center" Margin="0,0,3,0" />
                <Button Content="◀◀" Click="NudgeDownbeatLeftFine_Click"
                        Style="{StaticResource TransportButton}" Margin="0,0,2,0"
                        Width="28" FontSize="9" ToolTip="Fine nudge grid earlier (1ms)" />
                <Button Content="◀" Click="NudgeDownbeatLeft_Click"
                        Style="{StaticResource TransportButton}" Margin="0,0,2,0"
                        Width="28" ToolTip="Nudge grid earlier (1/32 note)" />
                <Button Content="▶" Click="NudgeDownbeatRight_Click"
                        Style="{StaticResource TransportButton}" Margin="0,0,2,0"
                        Width="28" ToolTip="Nudge grid later (1/32 note)" />
                <Button Content="▶▶" Click="NudgeDownbeatRightFine_Click"
                        Style="{StaticResource TransportButton}" Margin="0,0,3,0"
                        Width="28" FontSize="9" ToolTip="Fine nudge grid later (1ms)" />
                <TextBlock x:Name="DownbeatInfoText" Text="" FontSize="9"
                           Foreground="#7ED321" VerticalAlignment="Center" />
                <TextBlock Text=" | " Foreground="#4A4A60" VerticalAlignment="Center" />
                <Button Content="Zoom In" Click="ZoomIn_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0" />
                <Button Content="Zoom Out" Click="ZoomOut_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0" />
                <TextBlock Text="  |  " Foreground="#4A4A60" VerticalAlignment="Center" />
                <Button x:Name="TapSlideTimingBtn" Content="Tap Slide Timing"
                        Click="TapSlideTimingBtn_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0"
                        Background="DarkMagenta" Foreground="White"
                        ToolTip="Play section and tap SPACE at each slide break to set timing" />
                <TextBlock Text="  |  " Foreground="#4A4A60" VerticalAlignment="Center" />
                <Button Content="APPLY" Click="Apply_Click" Margin="4,0"
                        Style="{StaticResource TransportButton}"
                        Background="#F5A623" Foreground="Black" FontWeight="ExtraBold" />
                <Button Content="Cancel" Click="Cancel_Click"
                        Style="{StaticResource TransportButton}" Margin="4,0" />
            </StackPanel>

            <!-- Tap Slide Timing Panel (hidden by default) -->
            <Border x:Name="TapTimingPanel" Visibility="Collapsed"
                    Background="#1A0A2E" BorderBrush="#8E44AD" BorderThickness="2"
                    CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock x:Name="TapTimingInstruction" FontSize="14" FontWeight="Bold"
                               Foreground="#E74CFF" TextWrapping="Wrap"
                               Text="TAP SLIDE TIMING: Press SPACE at each slide break" />
                    <TextBlock x:Name="TapTimingStatus" FontSize="12" Foreground="#B0B0C0"
                               Margin="0,4,0,4" TextWrapping="Wrap"
                               Text="Waiting to start..." />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TapTimingStartBtn" Content="START"
                                Click="TapTimingStart_Click" Margin="0,0,8,0"
                                Background="#8E44AD" Foreground="White" FontWeight="Bold"
                                Padding="12,4" />
                        <Button Content="DONE" Click="TapTimingDone_Click" Margin="0,0,8,0"
                                Background="#7ED321" Foreground="Black" FontWeight="Bold"
                                Padding="12,4" />
                        <Button Content="Cancel" Click="TapTimingCancel_Click" Margin="0,0,0,0"
                                Padding="8,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
