<Window x:Class="WorshipPlayer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worship Backtrack Player"
        Height="800" Width="1280"
        MinHeight="600" MinWidth="1024"
        Background="{StaticResource PrimaryDarkBrush}"
        WindowState="Maximized"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />    <!-- Header / Song Info -->
            <RowDefinition Height="Auto" />    <!-- Section Buttons -->
            <RowDefinition Height="*" />       <!-- Channel Strips -->
            <RowDefinition Height="Auto" />    <!-- Transport Controls -->
            <RowDefinition Height="Auto" />    <!-- Status Bar -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />    <!-- Left Panel (Setlist + Sections) -->
            <ColumnDefinition Width="*" />      <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: Setlist + Sections Control -->
        <Border Grid.Column="0" Grid.RowSpan="5"
                Background="{StaticResource SecondaryDarkBrush}"
                BorderBrush="{StaticResource SurfaceDarkBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Setlist Header -->
                <TextBlock Grid.Row="0" Text="SETLIST" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="12,10,12,4" />

                <!-- Setlist Songs -->
                <ListBox x:Name="SetlistBox" Grid.Row="1"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderThickness="0"
                         SelectionChanged="SetlistBox_SelectionChanged"
                         Margin="4,0">
                </ListBox>

                <!-- Sections Header -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,8,12,4">
                    <TextBlock Text="SECTIONS" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="  (1-click=1x, 2-click=loop)" FontSize="9"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Section Buttons (iSingWorship-style) -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="4,0">
                    <StackPanel x:Name="SectionButtonsPanel" Orientation="Vertical" />
                </ScrollViewer>

                <!-- Bottom Buttons -->
                <StackPanel Grid.Row="4" Margin="8,4,8,8">
                    <Button Content="+ Add Song" Style="{StaticResource TransportButton}"
                            Click="AddSong_Click" Margin="0,3" FontSize="12" MinHeight="34" />
                    <Button Content="Edit Song Info" Style="{StaticResource TransportButton}"
                            Click="EditSongInfo_Click" Margin="0,3" FontSize="12" MinHeight="34" />
                    <Button Content="Edit Sections" Style="{StaticResource TransportButton}"
                            Click="EditSections_Click" Margin="0,3" FontSize="12" MinHeight="34" />
                    <Button Content="Chord Chart" Style="{StaticResource TransportButton}"
                            Click="ChordChart_Click" Margin="0,3" FontSize="12" MinHeight="34" />
                    <Button Content="Lighting" Style="{StaticResource TransportButton}"
                            Click="Lighting_Click" Margin="0,3" FontSize="12" MinHeight="34" />
                    <Button Content="MIDI Cues" Style="{StaticResource TransportButton}"
                            Click="MidiCues_Click" Margin="0,3" FontSize="12" MinHeight="34"
                            ToolTip="Edit MIDI cues for WorshipTools Presenter lyric sync" />
                    <Button Content="PRESENTER" Style="{StaticResource TransportButton}"
                            Click="OpenPresenter_Click" Margin="0,3" FontSize="12" MinHeight="34"
                            ToolTip="Open Lyric Presenter (operator + output windows)"
                            FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- HEADER: Song Info & Tempo/Key -->
        <Border Grid.Row="0" Grid.Column="1"
                Background="{StaticResource SecondaryDarkBrush}"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Song Title & Info -->
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SongTitleText" Text="No Song Loaded"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SongInfoText" Text="Load a song to begin"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- TEMPO Control -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="TEMPO:" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="-" Width="30" Height="30"
                            Style="{StaticResource TransportButton}"
                            Click="TempoDown_Click" />
                    <TextBlock x:Name="TempoText" Text="100%" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBlueBrush}"
                               VerticalAlignment="Center" Margin="8,0"
                               MinWidth="60" TextAlignment="Center" />
                    <Button Content="+" Width="30" Height="30"
                            Style="{StaticResource TransportButton}"
                            Click="TempoUp_Click" />
                </StackPanel>

                <!-- KEY Control -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="KEY:" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="b" Width="30" Height="30" FontSize="16"
                            Style="{StaticResource TransportButton}"
                            Click="PitchDown_Click" />
                    <TextBlock x:Name="KeyText" Text="C (0)" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentOrangeBrush}"
                               VerticalAlignment="Center" Margin="8,0"
                               MinWidth="70" TextAlignment="Center" />
                    <Button Content="#" Width="30" Height="30" FontSize="16"
                            Style="{StaticResource TransportButton}"
                            Click="PitchUp_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SECTION BUTTONS -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{StaticResource PrimaryDarkBrush}"
                Padding="12,8">
            <StackPanel>
                <TextBlock Text="SECTIONS" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                <WrapPanel x:Name="SectionsPanel" Orientation="Horizontal">
                    <!-- Section buttons will be added dynamically -->
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- CHANNEL STRIPS -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="{StaticResource PrimaryDarkBrush}"
                Padding="12,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ChannelStripsPanel" Orientation="Horizontal">
                    <!-- Channel strips will be added dynamically -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- TRANSPORT CONTROLS -->
        <Border Grid.Row="3" Grid.Column="1"
                Background="{StaticResource SecondaryDarkBrush}"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Position Info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PositionText" Text="0:00:000"
                               FontSize="24" FontFamily="Consolas"
                               Foreground="{StaticResource AccentGreenBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="BarBeatText" Text="  Bar 1 | Beat 1"
                               FontSize="16" FontFamily="Consolas"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="20,0,0,0" />
                    <TextBlock x:Name="CurrentSectionText" Text="  [INTRO]"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource AccentOrangeBrush}"
                               VerticalAlignment="Center" Margin="20,0,0,0" />
                </StackPanel>

                <!-- Transport Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PrevSectionBtn" Content="|&lt;&lt;"
                            Style="{StaticResource TransportButton}"
                            Click="PrevSection_Click" Margin="4,0" />
                    <Button x:Name="PlayBtn" Content="PLAY"
                            Style="{StaticResource TransportButton}"
                            Click="Play_Click" Margin="4,0"
                            MinWidth="100" FontSize="18" />
                    <Button x:Name="StopBtn" Content="STOP"
                            Style="{StaticResource TransportButton}"
                            Click="Stop_Click" Margin="4,0" />
                    <Button x:Name="NextSectionBtn" Content="&gt;&gt;|"
                            Style="{StaticResource TransportButton}"
                            Click="NextSection_Click" Margin="4,0" />
                    <Button x:Name="LoopBtn" Content="LOOP"
                            Style="{StaticResource TransportButton}"
                            Click="Loop_Click" Margin="16,0,4,0" />
                </StackPanel>

                <!-- Loop Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LoopStatusText" Text="Loop: ON (Infinite)"
                               FontSize="13" Foreground="{StaticResource AccentGreenBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Grid.Column="1"
                Background="{StaticResource SurfaceDarkBrush}"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusText"
                           Text="Ready | [SPACE]=Play/Stop  [L]=Loop  [Arrow]=Sections  [1-9]=Jump"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" x:Name="OscStatusText"
                           Text="OSC: Disconnected"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="20,0" />

                <TextBlock Grid.Column="2" x:Name="OutputModeText"
                           Text="Output: Pan-Split (L=FOH, R=IEM)"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
