<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WorshipPlayer.UI</RootNamespace>
    <AssemblyName>WorshipBacktrackPlayer</AssemblyName>
  </PropertyGroup>

  <!-- Copy Songs, Setlists, Scripts folders to output on build/publish -->
  <ItemGroup>
    <Content Include="..\Songs\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="Songs" />
    <Content Include="..\Setlists\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="Setlists" />
    <Content Include="..\Scripts\**\*.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="Scripts" />
    <Content Include="..\settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="settings.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <PackageReference Include="NAudio.Midi" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WorshipPlayer.Core\WorshipPlayer.Core.csproj" />
    <ProjectReference Include="..\WorshipPlayer.Audio\WorshipPlayer.Audio.csproj" />
    <ProjectReference Include="..\WorshipPlayer.Presenter\WorshipPlayer.Presenter.csproj" />
  </ItemGroup>

</Project>
